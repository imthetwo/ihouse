		<ImplicitUsings>enable</ImplicitUsings>
	  <UserSecretsId>1d85f5b3-27e3-498a-bfef-4acf5c12afe6</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="MailKit" Version="4.18.2" />
