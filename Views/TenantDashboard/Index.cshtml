
@{
    ViewData["Title"] = "Tenant Dashboard";
    Layout = "_TenantLayout";
}

<div class="mb-4">
    <h2 class="fw-bold">My Dashboard</h2>
    <p class="text-muted">
        Welcome to your iHouse tenant portal.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-house-door"></i>
            </div>

            <h5 class="fw-bold">My Room</h5>
            <p class="text-muted mb-0">
                View your rented room information.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <h5 class="fw-bold">My Contract</h5>
            <p class="text-muted mb-0">
                View your rental agreement
                and contract details.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <h5 class="fw-bold">My Invoices</h5>
            <p class="text-muted mb-0">
                Check rent, electricity,
                water and service charges.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-credit-card"></i>
            </div>

            <h5 class="fw-bold">My Payments</h5>
            <p class="text-muted mb-0">
                View your payment history
                and transaction information.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-speedometer2"></i>
            </div>

            <h5 class="fw-bold">Utility Usage</h5>
            <p class="text-muted mb-0">
                View monthly electricity
                and water consumption.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="tenant-card">
            <div class="tenant-card-icon">
                <i class="bi bi-tools"></i>
            </div>

            <h5 class="fw-bold">Maintenance</h5>
            <p class="text-muted mb-0">
                Submit and track maintenance requests.
            </p>
        </div>
    </div>

</div>

<div class="alert alert-info mt-4">
    <i class="bi bi-info-circle me-2"></i>
    Your personal rental information will appear here
    after your tenant account is linked to a contract.
</div>
