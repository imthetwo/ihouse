
@model ihouse.ViewModels.TenantDashboardViewModel

@{
    ViewData["Title"] = "Tenant Dashboard";
    Layout = "_TenantLayout";

    var room = Model.Room;
    var contract = Model.Contract;

    var unpaidInvoices = Model.Invoices
        .Where(i => i.Balance > 0
            && i.Status != "Cancelled"
            && i.Status != "Canceled"
            && i.Status != "Void")
        .OrderBy(i => i.DueDate)
        .ToList();

    var pendingApprovals = Model.MaintenanceRequests
        .Count(m => m.ApprovalStatus == "Pending"
            && m.ProposedTenantCost > 0);

    string Money(decimal amount) => amount.ToString("C2",
        System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}

<!-- ============================
     PAGE HEADER
============================= -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h4 class="tenant-page-title mb-2">My Dashboard</h4>
        <p class="text-muted mb-0">
            Welcome to iHouse, @Model.TenantName.
        </p>
    </div>

    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
        <i class="bi bi-person-circle me-1"></i>
        Tenant Portal
    </span>
</div>

<!-- FEEDBACK -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.TenantLinked)
{
    <div class="alert alert-info border-0 mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Your account is not linked to a tenant profile yet.
        Please contact the property administrator.
    </div>
}
else if (contract == null)
{
    <div class="alert alert-info border-0 mb-4">
        <i class="bi bi-info-circle me-2"></i>
        No active rental contract was found for your account.
    </div>
}

<!-- ============================
     OVERVIEW CARDS
============================= -->
<div class="row g-4 mb-4">

    <!-- MY ROOM -->
    <div class="col-12 col-md-6 col-xl-3">
        <button type="button"
                class="tenant-card tenant-card-action w-100 text-start"
                data-bs-toggle="modal"
                data-bs-target="#roomModal">

            <div class="tenant-card-icon">
                <i class="bi bi-house-door"></i>
            </div>

            <p class="text-muted mb-2">My Room</p>

            <h5 class="fw-bold mb-1">
                @(room?.RoomNumber ?? "Not available")
            </h5>

            <small class="text-primary">
                View room details
                <i class="bi bi-arrow-right ms-1"></i>
            </small>
        </button>
    </div>

    <!-- MY CONTRACT -->
    <div class="col-12 col-md-6 col-xl-3">
        <button type="button"
                class="tenant-card tenant-card-action w-100 text-start"
                data-bs-toggle="modal"
                data-bs-target="#contractModal">

            <div class="tenant-card-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <p class="text-muted mb-2">My Contract</p>

            <h5 class="fw-bold mb-1">
                @(contract?.Status ?? "Not available")
            </h5>

            <small class="text-primary">
                View contract details
                <i class="bi bi-arrow-right ms-1"></i>
            </small>
        </button>
    </div>

    <!-- UNPAID INVOICES -->
    <div class="col-12 col-md-6 col-xl-3">
        <button type="button"
                class="tenant-card tenant-card-action w-100 text-start"
                data-bs-toggle="modal"
                data-bs-target="#invoiceModal">

            <div class="tenant-card-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <p class="text-muted mb-2">Unpaid Invoices</p>

            <h5 class="fw-bold mb-1">
                @unpaidInvoices.Count Invoice(s)
            </h5>

            <small class="text-primary">
                View invoice breakdown
                <i class="bi bi-arrow-right ms-1"></i>
            </small>
        </button>
    </div>

    <!-- MAINTENANCE -->
    <div class="col-12 col-md-6 col-xl-3">
        <button type="button"
                class="tenant-card tenant-card-action w-100 text-start"
                data-bs-toggle="modal"
                data-bs-target="#maintenanceModal">

            <div class="tenant-card-icon">
                <i class="bi bi-tools"></i>
            </div>

            <p class="text-muted mb-2">Maintenance</p>

            <h5 class="fw-bold mb-1">
                @if (pendingApprovals > 0)
                {
                    <span class="text-warning">
                        @pendingApprovals Awaiting Approval
                    </span>
                }
                else
                {
                    <span>
                        @Model.MaintenanceRequests.Count Request(s)
                    </span>
                }
            </h5>

            <small class="text-primary">
                Manage maintenance requests
                <i class="bi bi-arrow-right ms-1"></i>
            </small>
        </button>
    </div>
</div>

<!-- ============================
     RENTAL & PAYMENT OVERVIEW
============================= -->
<div class="row g-4 mb-4">

    <!-- RENTAL INFORMATION -->
    <div class="col-12 col-lg-7">
        <div class="tenant-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">My Rental Information</h5>
                <i class="bi bi-house text-primary fs-5"></i>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                        <tr>
                            <th class="text-muted fw-normal">
                                Room Number
                            </th>
                            <td class="text-end fw-semibold">
                                @(room?.RoomNumber ?? "Not available")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal">
                                Room Type
                            </th>
                            <td class="text-end fw-semibold">
                                @(room?.RoomType ?? "Not available")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal">
                                Monthly Rent
                            </th>
                            <td class="text-end fw-semibold">
                                @(contract != null
                                    ? Money(contract.MonthlyRent)
                                    : "Not available")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal">
                                Contract Period
                            </th>
                            <td class="text-end fw-semibold">
                                @(contract != null
                                    ? $"{contract.StartDate:dd/MM/yyyy} - {contract.EndDate:dd/MM/yyyy}"
                                    : "Not available")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal">
                                Contract Status
                            </th>
                            <td class="text-end fw-semibold">
                                @(contract?.Status ?? "Not available")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAYMENT OVERVIEW -->
    <div class="col-12 col-lg-5">
        <div class="tenant-card">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Payment Overview</h5>
                <i class="bi bi-credit-card text-primary fs-5"></i>
            </div>

            <p class="text-muted mb-2">Outstanding Balance</p>
            <h3 class="fw-bold mb-3">
                @Money(Model.OutstandingBalance)
            </h3>

            <hr />

            <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Next Due Date</span>
                <span class="fw-semibold">
                    @(Model.NextDueDate?.ToString("dd/MM/yyyy")
                        ?? "Not available")
                </span>
            </div>

            <div class="d-flex justify-content-between mb-4">
                <span class="text-muted">Payment Status</span>

                @if (Model.OutstandingBalance > 0)
                {
                    <span class="badge bg-warning text-dark">
                        Outstanding
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        No Outstanding Balance
                    </span>
                }
            </div>

            <button type="button"
                    class="btn btn-primary w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#paymentModal">

                <i class="bi bi-eye me-1"></i>
                View Payment Details
            </button>
        </div>
    </div>
</div>

<!-- ============================
     RECENT ACTIVITY
============================= -->
<div class="tenant-card">
    <h5 class="fw-bold mb-4">
        <i class="bi bi-clock-history text-primary me-2"></i>
        Recent Activity
    </h5>

    @{
        var latestInvoice = Model.Invoices
            .OrderByDescending(i => i.InvoiceDate)
            .FirstOrDefault();

        var latestPayment = Model.Payments
            .OrderByDescending(p => p.PaymentDate)
            .FirstOrDefault();

        var latestMaintenance = Model.MaintenanceRequests
            .OrderByDescending(m => m.CreatedAt)
            .FirstOrDefault();
    }

    @if (latestInvoice == null
        && latestPayment == null
        && latestMaintenance == null)
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No activity to display.
        </div>
    }
    else
    {
        @if (latestInvoice != null)
        {
            <div class="d-flex gap-3 mb-3">
                <i class="bi bi-receipt text-primary fs-5"></i>
                <div>
                    <div class="fw-semibold">
                        Invoice #@latestInvoice.Id
                    </div>
                    <small class="text-muted">
                        @latestInvoice.InvoiceDate.ToString("dd/MM/yyyy")
                        · @Money(latestInvoice.TotalAmount)
                        · @latestInvoice.Status
                    </small>
                </div>
            </div>
        }

        @if (latestMaintenance != null)
        {
            <div class="d-flex gap-3 mb-3">
                <i class="bi bi-tools text-warning fs-5"></i>
                <div>
                    <div class="fw-semibold">
                        Maintenance Request #@latestMaintenance.Id
                    </div>
                    <small class="text-muted">
                        @latestMaintenance.Description
                        · @latestMaintenance.Status
                        · Approval: @latestMaintenance.ApprovalStatus
                    </small>
                </div>
            </div>
        }

        @if (latestPayment != null)
        {
            <div class="d-flex gap-3">
                <i class="bi bi-credit-card text-success fs-5"></i>
                <div>
                    <div class="fw-semibold">
                        Payment for Invoice #@latestPayment.InvoiceId
                    </div>
                    <small class="text-muted">
                        @latestPayment.PaymentDate.ToString("dd/MM/yyyy")
                        · @Money(latestPayment.Amount)
                    </small>
                </div>
            </div>
        }
    }
</div>

<!-- ============================
     ROOM MODAL
============================= -->
<div class="modal fade"
     id="roomModal"
     tabindex="-1"
     aria-labelledby="roomModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="roomModalTitle">
                    <i class="bi bi-house-door text-primary me-2"></i>
                    My Room
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                @if (room == null)
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-house fs-1 d-block mb-3"></i>
                        No active room information available.
                    </div>
                }
                else
                {
                    <div class="tenant-room-preview mb-4">
                        <div class="tenant-room-placeholder">
                            <i class="bi bi-image fs-1"></i>
                            <span>Room image not available</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                        {
                            <img src="@room.ImageUrl"
                                 class="tenant-room-photo"
                                 alt="Room @room.RoomNumber"
                                 onerror="this.style.display='none';" />
                        }
                    </div>

                    <div class="row g-4">
                        <div class="col-6">
                            <small class="text-muted">Room Number</small>
                            <p class="fw-semibold mb-0">
                                @room.RoomNumber
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Floor</small>
                            <p class="fw-semibold mb-0">
                                @room.Floor
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Room Type</small>
                            <p class="fw-semibold mb-0">
                                @room.RoomType
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Capacity</small>
                            <p class="fw-semibold mb-0">
                                @room.Capacity person(s)
                            </p>
                        </div>

                        <div class="col-12">
                            <small class="text-muted">Monthly Rent</small>
                            <h5 class="fw-bold mb-0">
                                @(contract != null
                                    ? Money(contract.MonthlyRent)
                                    : "Not available")
                            </h5>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(room.Description))
                        {
                            <div class="col-12">
                                <small class="text-muted">Description</small>
                                <p class="mb-0">@room.Description</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================
     CONTRACT MODAL
============================= -->
<div class="modal fade"
     id="contractModal"
     tabindex="-1"
     aria-labelledby="contractModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="contractModalTitle">
                    <i class="bi bi-file-earmark-text text-primary me-2"></i>
                    My Contract
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">

                @if (contract == null)
                {
                    <p class="text-muted text-center py-4">
                        No active rental contract available.
                    </p>
                }
                else
                {
                    <div class="row g-4">
                        <div class="col-6">
                            <small class="text-muted">Contract ID</small>
                            <p class="fw-semibold mb-0">
                                #@contract.Id
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Status</small>
                            <p class="fw-semibold mb-0">
                                @contract.Status
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Room</small>
                            <p class="fw-semibold mb-0">
                                @(room?.RoomNumber ?? "Not available")
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Payment Method</small>
                            <p class="fw-semibold mb-0">
                                @contract.PaymentMethod
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Start Date</small>
                            <p class="fw-semibold mb-0">
                                @contract.StartDate.ToString("dd/MM/yyyy")
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">End Date</small>
                            <p class="fw-semibold mb-0">
                                @contract.EndDate.ToString("dd/MM/yyyy")
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Monthly Rent</small>
                            <p class="fw-semibold mb-0">
                                @Money(contract.MonthlyRent)
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Deposit Amount</small>
                            <p class="fw-semibold mb-0">
                                @Money(contract.DepositAmount)
                            </p>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Contract information is read-only.
                    </div>
                }

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================
     INVOICE MODAL
============================= -->
<div class="modal fade"
     id="invoiceModal"
     tabindex="-1"
     aria-labelledby="invoiceModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="invoiceModalTitle">
                    <i class="bi bi-receipt text-primary me-2"></i>
                    My Invoices
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <p class="text-muted">
                    Select an invoice to view its detailed charges.
                </p>

                @if (!Model.Invoices.Any())
                {
                    <p class="text-center text-muted py-4">
                        No invoices found.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th>Due Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var invoice in Model.Invoices)
                                {
                                    <tr>
                                        <td>#@invoice.Id</td>

                                        <td>
                                            @invoice.DueDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>@Money(invoice.TotalAmount)</td>

                                        <td>
                                            @if (invoice.Balance <= 0)
                                            {
                                                <span class="badge bg-success">
                                                    Paid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    @invoice.Status
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#invoiceDetail-@invoice.Id"
                                                    aria-expanded="false"
                                                    aria-controls="invoiceDetail-@invoice.Id">
                                                Details
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td colspan="5" class="p-0 border-0">
                                            <div class="collapse"
                                                 id="invoiceDetail-@invoice.Id">

                                                <div class="border rounded-3 p-3 m-2">

                                                    <h6 class="fw-bold mb-3">
                                                        Invoice #@invoice.Id Breakdown
                                                    </h6>

                                                    @if (invoice.Items.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Charge</th>
                                                                        <th>Qty</th>
                                                                        <th>Unit Price</th>
                                                                        <th class="text-end">
                                                                            Amount
                                                                        </th>
                                                                    </tr>
                                                                </thead>

                                                                <tbody>
                                                                    @foreach (var item in invoice.Items)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <strong>
                                                                                    @item.ItemType
                                                                                </strong>

                                                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                                                {
                                                                                    <div class="small text-muted">
                                                                                        @item.Description
                                                                                    </div>
                                                                                }
                                                                            </td>

                                                                            <td>@item.Quantity</td>

                                                                            <td>
                                                                                @Money(item.UnitPrice)
                                                                            </td>

                                                                            <td class="text-end">
                                                                                @Money(item.Amount)
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted">
                                                            No item breakdown available.
                                                        </p>
                                                    }

                                                    <hr />

                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span>Invoice Total</span>
                                                        <strong>
                                                            @Money(invoice.TotalAmount)
                                                        </strong>
                                                    </div>

                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span>Amount Paid</span>
                                                        <span>
                                                            @Money(invoice.PaidAmount)
                                                        </span>
                                                    </div>

                                                    <div class="d-flex justify-content-between">
                                                        <strong>Balance Due</strong>
                                                        <strong class="text-primary">
                                                            @Money(invoice.Balance)
                                                        </strong>
                                                    </div>

                                                    @if (invoice.Balance > 0)
                                                    {
                                                        <div class="alert alert-light border mt-3 mb-0">
                                                            Payment processing is not yet
                                                            available in the Tenant Portal.
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================
     PAYMENT MODAL
============================= -->
<div class="modal fade"
     id="paymentModal"
     tabindex="-1"
     aria-labelledby="paymentModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="paymentModalTitle">
                    <i class="bi bi-credit-card text-primary me-2"></i>
                    Payment Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">
                                Outstanding Balance
                            </small>

                            <h4 class="fw-bold mt-2 mb-0">
                                @Money(Model.OutstandingBalance)
                            </h4>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">
                                Unpaid Invoices
                            </small>

                            <h4 class="fw-bold mt-2 mb-0">
                                @unpaidInvoices.Count
                            </h4>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3">Outstanding Charges</h6>

                @if (unpaidInvoices.Count == 0)
                {
                    <p class="text-muted">
                        No outstanding invoices.
                    </p>
                }
                else
                {
                    @foreach (var invoice in unpaidInvoices)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <strong>Invoice #@invoice.Id</strong>

                                <div class="small text-muted">
                                    Due @invoice.DueDate.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <strong>@Money(invoice.Balance)</strong>
                        </div>
                    }
                }

                <hr />

                <h6 class="fw-bold mb-3">Payment History</h6>

                @if (!Model.Payments.Any())
                {
                    <p class="text-muted text-center py-3">
                        No payment history available.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Invoice</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Reference</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>
                                            @payment.PaymentDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>#@payment.InvoiceId</td>

                                        <td>@payment.PaymentMethod</td>

                                        <td>
                                            @Money(payment.Amount)
                                        </td>

                                        <td>
                                            @(payment.TransactionCode ?? "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="alert alert-light border mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Payments shown here are recorded transactions.
                    Online payment processing is not yet enabled.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================
     MAINTENANCE MODAL
============================= -->
<div class="modal fade"
     id="maintenanceModal"
     tabindex="-1"
     aria-labelledby="maintenanceModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="maintenanceModalTitle">
                    <i class="bi bi-tools text-primary me-2"></i>
                    Maintenance Management
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">

                <!-- NEW REQUEST -->
                <h6 class="fw-bold mb-3">
                    New Maintenance Request
                </h6>

                @if (contract == null)
                {
                    <div class="alert alert-info">
                        An active rental contract is required
                        to submit a maintenance request.
                    </div>
                }
                else
                {
                    <form asp-controller="TenantDashboard"
                          asp-action="CreateMaintenanceRequest"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Room
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@room?.RoomNumber"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label for="maintenanceDescription"
                                   class="form-label fw-semibold">
                                Describe the Issue
                            </label>

                            <textarea id="maintenanceDescription"
                                      name="description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="2000"
                                      required
                                      placeholder="Describe the issue in your room..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>
                            Submit Request
                        </button>
                    </form>
                }

                <hr class="my-4" />

                <!-- REQUEST HISTORY -->
                <h6 class="fw-bold mb-3">
                    Request History
                </h6>

                @if (!Model.MaintenanceRequests.Any())
                {
                    <p class="text-muted text-center py-4">
                        No maintenance requests available.
                    </p>
                }
                else
                {
                    @foreach (var request in Model.MaintenanceRequests)
                    {
                        <div class="border rounded-3 p-3 mb-3">

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <strong>
                                    Request #@request.Id
                                </strong>

                                <span class="badge bg-secondary">
                                    @request.Status
                                </span>
                            </div>

                            <p class="mb-2">
                                <strong>Issue:</strong>
                                @request.Description
                            </p>

                            <p class="text-muted small mb-3">
                                Submitted:
                                @request.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Quotation Approval</span>

                                @switch (request.ApprovalStatus)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">
                                            Awaiting Approval
                                        </span>
                                        break;

                                    case "Approved":
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                        break;

                                    case "Rejected":
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-secondary">
                                            Not Required
                                        </span>
                                        break;
                                }
                            </div>

                            @if (request.Costs.Any())
                            {
                                <div class="bg-light rounded-3 p-3 mb-3">

                                    <h6 class="fw-bold mb-3">
                                        Maintenance Cost Details
                                    </h6>

                                    @foreach (var cost in request.Costs)
                                    {
                                        <div class="d-flex justify-content-between gap-3 mb-2">
                                            <div>
                                                <span>
                                                    @(cost.Description
                                                        ?? "Maintenance cost")
                                                </span>

                                                @if (!cost.ChargeToTenant)
                                                {
                                                    <div class="small text-muted">
                                                        Paid by property
                                                    </div>
                                                }
                                            </div>

                                            <span>
                                                @Money(cost.Amount)
                                            </span>
                                        </div>
                                    }

                                    <hr />

                                    <div class="d-flex justify-content-between">
                                        <strong>Tenant Proposed Cost</strong>
                                        <strong>
                                            @Money(request.ProposedTenantCost)
                                        </strong>
                                    </div>
                                </div>
                            }

                            @if (request.ApprovalStatus == "Pending"
                                && request.ProposedTenantCost > 0
                                && request.Status == "Pending")
                            {
                                <p class="text-muted small">
                                    Review the quotation before making
                                    your decision. Approval does not
                                    record a payment.
                                </p>

                                <div class="d-flex justify-content-end gap-2 flex-wrap">

                                    <!-- REJECT -->
                                    <form asp-controller="TenantDashboard"
                                          asp-action="RejectMaintenance"
                                          method="post"
                                          onsubmit="return confirm('Reject this maintenance quotation?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-outline-danger">
                                            Reject
                                        </button>
                                    </form>

                                    <!-- APPROVE -->
                                    <form asp-controller="TenantDashboard"
                                          asp-action="ApproveMaintenance"
                                          method="post"
                                          onsubmit="return confirm('Accept the proposed maintenance cost?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-success">
                                            Accept
                                        </button>
                                    </form>

                                </div>
                            }

                            @if (request.ApprovalStatus == "Approved")
                            {
                                <div class="alert alert-success mb-0">
                                    Quotation approved.
                                    Staff can arrange the maintenance work.
                                </div>
                            }

                            @if (request.ApprovalStatus == "Rejected")
                            {
                                <div class="alert alert-warning mb-0">
                                    Quotation rejected.
                                    Staff may revise the proposal.
                                </div>
                            }

                            @if (request.Status == "Completed"
                                && request.CompletedAt.HasValue)
                            {
                                <p class="text-muted small mt-3 mb-0">
                                    Completed:
                                    @request.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            }
                        </div>
                    }
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
