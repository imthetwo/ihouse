
    @{
        ViewData["Title"] = "Connect Contract";
        Layout = "_TenantLayout";
    }

    <style>
        .connect-container {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }

        .connect-card {
            width: 100%;
            max-width: 480px;
            padding: 36px;
            background: #fff;
            border: 1px solid #e5eaf1;
            border-radius: 20px;
            box-shadow: 0 16px 45px rgba(24,49,83,.07);
        }

        .connect-icon {
            width: 76px;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            background: #eaf2ff;
            color: #0866d9;
            border-radius: 50%;
            font-size: 34px;
        }

        .connect-title {
            color: #183153;
            font-size: 25px;
            font-weight: 750;
            text-align: center;
        }

        .connect-description {
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            text-align: center;
        }

        .connect-input {
            min-height: 50px;
            border-radius: 10px;
            font-family: monospace;
            font-size: 14px;
        }

        .connect-submit {
            min-height: 48px;
            border-radius: 10px;
            font-weight: 600;
            background: #0866d9;
        }

        @@media (max-width: 576px) {
            .connect-card {
                padding: 26px 20px;
            }
        }
    </style>

    <div class="connect-container">

        <div class="connect-card">

            <div class="connect-icon">
                <i class="bi bi-house-add"></i>
            </div>

            <h1 class="connect-title mb-3">
                Connect Your Contract
            </h1>

            <p class="connect-description mb-4">
                Enter the invitation code provided by your
                property administrator to connect your rental
                contract and access your room information,
                invoices, payments and maintenance requests.
            </p>

            <div asp-validation-summary="All"
                 class="text-danger small mb-3"></div>

            <form asp-controller="TenantDashboard"
                  asp-action="Connect"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label for="code"
                           class="form-label fw-semibold">
                        Contract Invitation Code
                    </label>

                    <input type="text"
                           id="code"
                           name="code"
                           class="form-control connect-input"
                           placeholder="Enter your invitation code"
                           maxlength="128"
                           autocomplete="off"
                           autocapitalize="off"
                           spellcheck="false"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-primary connect-submit w-100">

                    <i class="bi bi-link-45deg me-2"></i>
                    Connect Contract

                </button>
                
            @{
                ViewData["Title"] = "Connect Contract";
                Layout = "_TenantLayout";
            }

            <style>
                .connect-container {
                    min-height: 75vh;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 40px 16px;
                }

                .connect-card {
                    width: 100%;
                    max-width: 480px;
                    padding: 36px;
                    background: #fff;
                    border: 1px solid #e5eaf1;
                    border-radius: 20px;
                    box-shadow: 0 16px 45px rgba(24, 49, 83, .07);
                }

                .connect-icon {
                    width: 76px;
                    height: 76px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 0 auto 24px;
                    background: #eaf2ff;
                    color: #0866d9;
                    border-radius: 50%;
                    font-size: 34px;
                }

                .connect-title {
                    color: #183153;
                    font-size: 25px;
                    font-weight: 750;
                    text-align: center;
                }

                .connect-description {
                    color: #64748b;
                    font-size: 14px;
                    line-height: 1.7;
                    text-align: center;
                }

                .connect-input {
                    min-height: 50px;
                    border-radius: 10px;
                    font-family: monospace;
                    font-size: 14px;
                }

                    .connect-input:focus {
                        border-color: #0866d9;
                        box-shadow: 0 0 0 .2rem rgba(8, 102, 217, .12);
                    }

                .connect-submit {
                    min-height: 48px;
                    border-radius: 10px;
                    font-weight: 600;
                    background: #0866d9;
                    border-color: #0866d9;
                }

                    .connect-submit:hover {
                        background: #0756b5;
                        border-color: #0756b5;
                    }

                    .connect-submit:disabled {
                        opacity: .7;
                        cursor: not-allowed;
                    }

                .validation-summary-valid {
                    display: none;
                }

                @@media (max-width: 576px) {
                    .connect-card {
                        padding: 26px 20px;
                    }
                }
            </style>

            <div class="connect-container">

                <div class="connect-card">

                    <!-- ICON -->
                    <div class="connect-icon">
                        <i class="bi bi-house-add"></i>
                    </div>

                    <!-- TITLE -->
                    <h1 class="connect-title mb-3">
                        Connect Your Contract
                    </h1>

                    <!-- DESCRIPTION -->
                    <p class="connect-description mb-4">
                        Enter the invitation code provided by your
                        property administrator to connect your rental
                        contract and access your room information,
                        invoices, payments and maintenance requests.
                    </p>

                    <!-- SUCCESS MESSAGE -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success small"
                             role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["Success"]
                        </div>
                    }

                    <!-- ERROR MESSAGE -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger small"
                             role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @TempData["Error"]
                        </div>
                    }

                    <!-- VALIDATION -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger small"
                             role="alert">
                        </div>
                    }

                    <!-- CONNECT FORM -->
                    <form id="connectContractForm"
                          asp-controller="TenantDashboard"
                          asp-action="Connect"
                          asp-antiforgery="true"
                          method="post">

                        <!--
                Anti-forgery token is generated
                automatically by ASP.NET Core.
                Do not add Html.AntiForgeryToken().
            -->

                        <div class="mb-3">

                            <label for="code"
                                   class="form-label fw-semibold">
                                Contract Invitation Code
                            </label>

                            <input type="text"
                                   id="code"
                                   name="code"
                                   class="form-control connect-input"
                                   placeholder="Enter your invitation code"
                                   maxlength="128"
                                   autocomplete="off"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   required
                                   autofocus />

                        </div>

                        <!-- SUBMIT -->
                        <button id="connectSubmitButton"
                                type="submit"
                                class="btn btn-primary connect-submit w-100">

                            <i class="bi bi-link-45deg me-2"></i>
                            <span id="connectButtonText">
                                Connect Contract
                            </span>

                        </button>

                    </form>

                    <!-- SECURITY INFORMATION -->
                    <div class="alert alert-light border mt-4 mb-0 small">

                        <i class="bi bi-shield-check text-primary me-2"></i>

                        For security, invitation codes expire after
                        24 hours and can only be used once.

                    </div>

                    <!-- FOOTER -->
                    <p class="text-center text-muted small mt-4 mb-0">
                        Don't have an invitation code?
                        Contact your property administrator.
                    </p>

                </div>

            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    const form =
                        document.getElementById("connectContractForm");

                    const button =
                        document.getElementById("connectSubmitButton");

                    const buttonText =
                        document.getElementById("connectButtonText");

                    const codeInput =
                        document.getElementById("code");

                    if (!form || !button || !codeInput) {
                        return;
                    }

                    let isSubmitting = false;

                    form.addEventListener("submit", function (event) {

                        if (isSubmitting) {
                            event.preventDefault();
                            return;
                        }

                        const code = codeInput.value.trim();

                        if (!code) {
                            event.preventDefault();
                            codeInput.focus();
                            return;
                        }

                        codeInput.value = code;

                        isSubmitting = true;

                        button.disabled = true;

                        if (buttonText) {
                            buttonText.textContent = "Connecting...";
                        }

                    });

                });
            </script>

            </form>

            <div class="alert alert-light border mt-4 mb-0 small">

                <i class="bi bi-shield-check text-primary me-2"></i>

                For security, invitation codes expire after
                24 hours and can only be used once.

            </div>

            <p class="text-center text-muted small mt-4 mb-0">
                Don't have an invitation code?
                Contact your property administrator.
            </p>

        </div>

    </div>
