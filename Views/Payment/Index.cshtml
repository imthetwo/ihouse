
@model IEnumerable<ihouse.Models.Payment>
@using ihouse.ViewModels.Payment
@using System.Globalization

@{
    ViewData["Title"] = "Payment Management";
    Layout = "_AdminLayout";

    var usd = CultureInfo.GetCultureInfo("en-US");

    var pendingRequests =
        ViewBag.PendingCashRequests
            as List<CashPaymentRequestViewModel>
        ?? new List<CashPaymentRequestViewModel>();

    var payments = Model.ToList();
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Payment Management
            </h3>

            <p class="text-muted mb-0">
                Review cash requests and manage confirmed payments.
            </p>
        </div>

        <a asp-controller="Payment"
           asp-action="Create"
           class="btn btn-primary rounded-3 px-4">

            <i class="bi bi-plus-lg me-2"></i>
            Record Payment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4"
             role="status">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 mb-4"
             role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">
                                Confirmed Payments
                            </p>

                            <h3 class="fw-bold mb-0">
                                @payments.Count
                            </h3>
                        </div>

                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">
                                Pending Cash Requests
                            </p>

                            <h3 class="fw-bold mb-0">
                                @pendingRequests.Count
                            </h3>
                        </div>

                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- PENDING CASH REQUESTS -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">
                        Cash Payment Requests
                    </h5>

                    <p class="text-muted small mb-0">
                        Confirm only after receiving the payment.
                    </p>
                </div>

                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    @pendingRequests.Count Pending
                </span>
            </div>

            @if (pendingRequests.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Request</th>
                                <th>Invoice</th>
                                <th>Contract</th>
                                <th>Requested (UTC)</th>
                                <th>Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in pendingRequests)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        #@request.RequestId
                                    </td>

                                    <td>
                                        #@request.InvoiceId
                                    </td>

                                    <td>
                                        #@request.ContractId
                                    </td>

                                    <td class="text-muted small">
                                        @request.RequestedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="fw-bold">
                                        @request.Amount.ToString("C2", usd)
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <!-- APPROVE -->
                                            <form asp-controller="Payment"
                                                  asp-action="ApproveCash"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm rounded-3 px-3">
                                                    <i class="bi bi-check-lg me-1"></i>
                                                    Confirm Received
                                                </button>
                                            </form>

                                            <!-- REJECT -->
                                            <form asp-controller="Payment"
                                                  asp-action="RejectCash"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm rounded-3 px-3">
                                                    Decline
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle text-success fs-1"></i>

                    <h6 class="fw-semibold mt-3 mb-1">
                        No pending requests
                    </h6>

                    <p class="text-muted small mb-0">
                        All cash payment requests have been processed.
                    </p>
                </div>
            }

        </div>
    </div>

    <!-- CONFIRMED PAYMENTS -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="mb-4">
                <h5 class="fw-bold mb-1">
                    Payment History
                </h5>

                <p class="text-muted small mb-0">
                    All recorded payments.
                </p>
            </div>

            @if (payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Payment</th>
                                <th>Invoice</th>
                                <th>Method</th>
                                <th>Transaction Code</th>
                                <th>Date (UTC)</th>
                                <th>Amount</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in payments)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        #@payment.Id
                                    </td>

                                    <td>
                                        #@payment.InvoiceId
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @payment.PaymentMethod
                                        </span>
                                    </td>

                                    <td class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(payment.TransactionCode)
                                            ? "—"
                                            : payment.TransactionCode)
                                    </td>

                                    <td class="text-muted small">
                                        @payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="fw-bold text-success">
                                        @payment.Amount.ToString("C2", usd)
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Payment"
                                           asp-action="Details"
                                           asp-route-id="@payment.Id"
                                           class="btn btn-outline-primary btn-sm rounded-3">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt text-secondary fs-1"></i>

                    <h6 class="fw-semibold mt-3">
                        No payments recorded
                    </h6>

                    <p class="text-muted small mb-0">
                        Confirmed payments will appear here.
                    </p>
                </div>
            }

        </div>
    </div>
</div>
