
@model IEnumerable<ihouse.Models.Payment>
@using System.Globalization

@{
    ViewData["Title"] = "Payment Management";
    Layout = "_AdminLayout";

    var payments = Model.ToList();
    var usd = CultureInfo.GetCultureInfo("en-US");

    var totalPayments = payments.Count;
    var totalReceived = payments.Sum(p => p.Amount);
}


<div class="container-fluid py-4">

   

<!-- PAGE HEADER -->
<div class="admin-page-header">

    <h4 class="admin-page-title">
        Payment Management
    </h4>

    <a asp-controller="Payment"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Payment
    </a>

</div>

    

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- SUMMARY AND ADD BUTTON -->
    <div class="d-flex justify-content-between
                align-items-start flex-wrap gap-3 mb-4">

        <!-- TOTAL PAYMENTS -->
        <div class="card border-0 shadow-sm"
             style="width:100%; max-width:500px;">

            <div class="card-body p-4">
                <p class="text-muted mb-2">
                    Total Payments
                </p>

                <h2 class="fw-bold mb-0">
                    @totalPayments
                </h2>
            </div>

        </div>

    </div>

    <!-- PAYMENT RECORDS -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <!-- TABLE HEADER -->
            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2 mb-4">

                <h5 class="fw-bold mb-0">
                    Payment Records
                </h5>

                <span class="text-muted small">
                    Total received:
                    <strong>
                        @totalReceived.ToString("C2", usd)
                    </strong>
                </span>

            </div>

            <!-- TABLE -->
            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Invoice</th>
                            <th>Amount</th>
                            <th>Payment Date</th>
                            <th>Payment Method</th>
                            <th>Transaction Code</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var payment in payments)
                        {
                            <tr>

                                <td>
                                    #@payment.Id
                                </td>

                                <td class="fw-semibold">
                                    #@payment.InvoiceId
                                </td>

                                <td class="fw-semibold">
                                    @payment.Amount.ToString("C2", usd)
                                </td>

                                <td>
                                    @payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @payment.PaymentMethod
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(payment.TransactionCode))
                                    {
                                        @payment.TransactionCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                            </tr>
                        }

                        <!-- EMPTY STATE -->
                        @if (!payments.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-credit-card fs-2 d-block mb-3"></i>
                                    No payments found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
