@model ihouse.ViewModels.Payment.PaymentFormViewModel
@using ihouse.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Record Cash Payment";
    Layout = "_AdminLayout";

    var invoices =
        ViewBag.InvoiceOptions as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

<div class="container-fluid py-4">

    <!-- BACK BUTTON -->
    <div class="mb-4">

        <a asp-controller="Payment"
           asp-action="Index"
           class="text-decoration-none text-muted small">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Payments

        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- HEADER -->
                    <div class="mb-4">

                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="d-flex
                                align-items-center
                                justify-content-center
                                rounded-circle
                                bg-success bg-opacity-10
                                text-success"
                                 style="width:56px;height:56px;">

                                <i class="bi bi-cash-stack fs-3"></i>

                            </div>

                            <div>

                                <h4 class="fw-bold mb-1">
                                    Record Cash Payment
                                </h4>

                                <p class="text-muted mb-0">
                                    Confirm a cash payment received from a tenant.
                                </p>

                            </div>

                        </div>

                    </div>

                    <!-- PAYMENT FORM -->
                    <form asp-controller="Payment"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <!-- INVOICE -->
                        <div class="mb-4">

                            <label asp-for="InvoiceId"
                                   class="form-label fw-semibold">

                                Invoice

                            </label>

                            <select asp-for="InvoiceId"
                                    asp-items="invoices"
                                    class="form-select rounded-3"
                                    required>

                                <option value="">
                                    Select an invoice
                                </option>

                            </select>

                            <span asp-validation-for="InvoiceId"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- PAYMENT METHOD -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Payment Method
                            </label>

                            <div class="form-control
                                bg-light
                                rounded-3
                                d-flex
                                align-items-center
                                gap-2">

                                <i class="bi bi-cash-coin text-success"></i>

                                <span class="fw-semibold">
                                    Cash
                                </span>

                                <span class="badge bg-success ms-auto">
                                    Manual Payment
                                </span>

                            </div>

                            <input asp-for="PaymentMethod"
                                   type="hidden"
                                   value="@((int)PaymentMethod.Cash)" />

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- AMOUNT -->
                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">

                                Amount (USD)

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="Amount"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       class="form-control rounded-end-3"
                                       placeholder="0.00"
                                       required />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- PAYMENT DATE -->
                        <div class="mb-4">

                            <label asp-for="PaymentDate"
                                   class="form-label fw-semibold">

                                Payment Date

                            </label>

                            <input asp-for="PaymentDate"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control rounded-3"
                                   required />

                            <div class="form-text">
                                Vietnam local time (UTC+7).
                            </div>

                            <span asp-validation-for="PaymentDate"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- PAYMENT REFERENCE -->
                        <div class="bg-light border rounded-3 p-3 mb-4">

                            <div class="d-flex align-items-start gap-2">

                                <i class="bi bi-receipt text-primary mt-1"></i>

                                <div>

                                    <div class="fw-semibold mb-1">
                                        Automatic Receipt Number
                                    </div>

                                    <p class="small text-muted mb-0">
                                        A unique cash receipt number will
                                        be generated automatically after
                                        saving the payment.
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- IMPORTANT NOTICE -->
                        <div class="alert alert-warning rounded-3 mb-4">

                            <div class="d-flex align-items-start gap-2">

                                <i class="bi bi-exclamation-triangle mt-1"></i>

                                <div class="small">

                                    <strong class="d-block mb-1">
                                        Before confirming
                                    </strong>

                                    Only record this payment after
                                    you have received the cash from
                                    the tenant.

                                    <div class="mt-2">
                                        If the tenant has already submitted
                                        a cash payment request, please
                                        confirm it from Payment Management.
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="d-flex
                            justify-content-end
                            flex-wrap
                            gap-2">

                            <a asp-controller="Payment"
                               asp-action="Index"
                               class="btn
                                btn-outline-secondary
                                rounded-3
                                px-4">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn
                                btn-success
                                rounded-3
                                px-4">

                                <i class="bi bi-check-circle me-2"></i>
                                Confirm Cash Payment

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>