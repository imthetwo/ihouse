
@model IEnumerable<ihouse.Models.Room>

@{
    ViewData["Title"] = "Room Management";
    Layout = "_AdminLayout";

    var usd = System.Globalization.CultureInfo
        .GetCultureInfo("en-US");

    var rooms = Model.ToList();

    var roomTypes = rooms
        .Select(r => r.RoomType)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t)
        .ToList();

    var totalRooms = rooms.Count;

    var maintenanceRooms = rooms.Count(r =>
        r.Status == ihouse.Models.Enums.RoomStatus.Maintenance);
}

<div class="container-fluid py-4">

    <!-- ACTIONS -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="text-muted small">
            Manage rental rooms, pricing and availability.
        </div>

        <a asp-controller="Rooms"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Room
        </a>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Total Rooms
                    </div>

                    <h3 class="fw-bold mb-0">
                        @totalRooms
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Operational Rooms
                    </div>

                    <h3 class="fw-bold text-success mb-0">
                        @(totalRooms - maintenanceRooms)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Under Maintenance
                    </div>

                    <h3 class="fw-bold text-warning mb-0">
                        @maintenanceRooms
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- MAIN CARD -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- FILTERS -->
            <div class="row g-3 mb-4">

                <div class="col-lg-5">
                    <label for="roomSearch" class="form-label small fw-semibold">
                        Search Rooms
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="search"
                               id="roomSearch"
                               class="form-control"
                               placeholder="Search room number or type..." />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label for="typeFilter" class="form-label small fw-semibold">
                        Room Type
                    </label>

                    <select id="typeFilter" class="form-select">
                        <option value="">All Types</option>

                        @foreach (var type in roomTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <label for="statusFilter" class="form-label small fw-semibold">
                        Status
                    </label>

                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Maintenance">Maintenance</option>
                    </select>
                </div>

                <div class="col-lg-2 d-flex align-items-end">
                    <button type="button"
                            id="resetFilters"
                            class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset
                    </button>
                </div>

            </div>

            <!-- ROOM TABLE -->
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Room Number</th>
                            <th>Floor</th>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Monthly Rent</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="roomTableBody">

                        @foreach (var room in rooms)
                        {
                            <tr class="room-row"
                                data-number="@room.RoomNumber"
                                data-type="@room.RoomType"
                                data-status="@room.Status">

                                <!-- IMAGE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                                    {
                                        <img src="@room.ImageUrl"
                                             alt="Room @room.RoomNumber"
                                             loading="lazy"
                                             style="width:100px;
                                                    height:68px;
                                                    object-fit:cover;
                                                    border-radius:8px;
                                                    border:1px solid #e5e7eb;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted border rounded"
                                             style="width:100px;height:68px;">
                                            <i class="bi bi-image fs-4"></i>
                                        </div>
                                    }
                                </td>

                                <!-- ROOM NUMBER -->
                                <td>
                                    <span class="fw-semibold">
                                        @room.RoomNumber
                                    </span>
                                </td>

                                <!-- FLOOR -->
                                <td>@room.Floor</td>

                                <!-- TYPE -->
                                <td>@room.RoomType</td>

                                <!-- CAPACITY -->
                                <td>
                                    <i class="bi bi-people text-muted me-1"></i>
                                    @room.Capacity
                                </td>

                                <!-- RENT -->
                                <td class="fw-semibold">
                                    @room.RentPrice.ToString("C2", usd)
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @if (room.Status == ihouse.Models.Enums.RoomStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">
                                            Maintenance
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">

                                        <a asp-controller="Rooms"
                                           asp-action="Edit"
                                           asp-route-id="@room.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Edit
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-controller="Rooms"
                                                  asp-action="Delete"
                                                  asp-route-id="@room.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this room?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- EMPTY STATE -->
            <div id="emptyState"
                 class="text-center text-muted py-5"
                 style="display:none;">
                <i class="bi bi-house-x fs-1 d-block mb-2"></i>
                No rooms found.
            </div>

            <!-- PAGINATION -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

                <span id="roomResultCount" class="text-muted small"></span>

                <div class="d-flex align-items-center gap-2">

                    <button type="button"
                            id="previousPage"
                            class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span id="pageInfo" class="small fw-semibold px-2"></span>

                    <button type="button"
                            id="nextPage"
                            class="btn btn-sm btn-outline-secondary">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>

                </div>

            </div>

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("roomSearch");
        const typeFilter = document.getElementById("typeFilter");
        const statusFilter = document.getElementById("statusFilter");
        const resetButton = document.getElementById("resetFilters");

        const rows = Array.from(
            document.querySelectorAll(".room-row")
        );

        const emptyState = document.getElementById("emptyState");
        const resultCount = document.getElementById("roomResultCount");
        const pageInfo = document.getElementById("pageInfo");
        const previousButton = document.getElementById("previousPage");
        const nextButton = document.getElementById("nextPage");

        const pageSize = 10;
        let currentPage = 1;

        function getFilteredRows() {

            const search = searchInput.value.trim().toLowerCase();
            const selectedType = typeFilter.value;
            const selectedStatus = statusFilter.value;

            return rows.filter(function (row) {

                const roomNumber = (row.dataset.number || "").toLowerCase();
                const roomType = row.dataset.type || "";
                const roomStatus = row.dataset.status || "";

                const matchesSearch =
                    roomNumber.includes(search) ||
                    roomType.toLowerCase().includes(search);

                const matchesType =
                    !selectedType || roomType === selectedType;

                const matchesStatus =
                    !selectedStatus || roomStatus === selectedStatus;

                return matchesSearch &&
                       matchesType &&
                       matchesStatus;
            });
        }

        function renderTable() {

            const filteredRows = getFilteredRows();

            const total = filteredRows.length;
            const totalPages = Math.max(
                1,
                Math.ceil(total / pageSize)
            );

            currentPage = Math.min(
                Math.max(1, currentPage),
                totalPages
            );

            // Hide all rows.
            rows.forEach(function (row) {
                row.style.display = "none";
            });

            // Show only rows on the current page.
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;

            filteredRows
                .slice(start, end)
                .forEach(function (row) {
                    row.style.display = "";
                });

            emptyState.style.display =
                total === 0 ? "block" : "none";

            const firstItem = total === 0 ? 0 : start + 1;
            const lastItem = Math.min(end, total);

            resultCount.textContent =
                "Showing " + firstItem +
                "-" + lastItem +
                " of " + total + " rooms";

            pageInfo.textContent =
                "Page " + currentPage +
                " of " + totalPages;

            previousButton.disabled =
                currentPage <= 1;

            nextButton.disabled =
                currentPage >= totalPages;
        }

        function resetPageAndRender() {
            currentPage = 1;
            renderTable();
        }

        searchInput.addEventListener(
            "input",
            resetPageAndRender
        );

        typeFilter.addEventListener(
            "change",
            resetPageAndRender
        );

        statusFilter.addEventListener(
            "change",
            resetPageAndRender
        );

        resetButton.addEventListener("click", function () {
            searchInput.value = "";
            typeFilter.value = "";
            statusFilter.value = "";

            resetPageAndRender();
        });

        previousButton.addEventListener("click", function () {
            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        });

        nextButton.addEventListener("click", function () {

            const totalPages = Math.max(
                1,
                Math.ceil(getFilteredRows().length / pageSize)
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderTable();
            }
        });

        renderTable();
    });
</script>
