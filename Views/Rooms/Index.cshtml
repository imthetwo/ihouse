
@model IEnumerable<ihouse.Models.Room>

@{
    ViewData["Title"] = "Room Management";

    var usd = System.Globalization.CultureInfo
        .GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Room Management</h2>
            <p class="text-muted">Manage rental rooms and pricing.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Room
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Room Number</th>
                            <th>Floor</th>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Monthly Rent</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var room in Model)
                        {
                            <tr>
                                <td>@room.RoomNumber</td>
                                <td>@room.Floor</td>
                                <td>@room.RoomType</td>
                                <td>@room.Capacity</td>

                                <td>
                                    @room.RentPrice.ToString("C2", usd)
                                </td>

                                <td>
                                    @room.Status
                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@room.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@room.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this room?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    No rooms available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
s