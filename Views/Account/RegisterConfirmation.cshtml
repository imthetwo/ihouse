@{
	ViewData["Title"] = "Check Your Email - iHouse";

	// Independent authentication page.
	// Do not render the admin sidebar or dashboard.
	Layout = null;

	var notice = TempData["EmailNotice"] as string;
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />

	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />

	<title>@ViewData["Title"]</title>

	<!-- Bootstrap Icons -->
	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

	<!-- Page CSS -->
	<link rel="stylesheet"
		  href="~/css/register-confirmation.css"
		  asp-append-version="true" />
</head>

<body>

	<main class="verify-page">

		<div class="verify-card">

			<!-- BRAND -->
			<div class="verify-brand">
				<div class="verify-brand-icon">
					<i class="bi bi-house-door-fill"></i>
				</div>

				<span>iHouse</span>
			</div>

			<!-- EMAIL ICON -->
			<div class="verify-icon">
				<i class="bi bi-envelope-check"></i>
			</div>

			<!-- HEADING -->
			<h1 class="verify-title">
				Check your email
			</h1>

			<p class="verify-description">
				Your account has been created.
				Please open your inbox and click
				the verification link to activate
				your iHouse account.
			</p>

			<!-- SERVER NOTICE -->
			@if (!string.IsNullOrWhiteSpace(notice))
			{
				<div class="verify-notice"
					 id="verifyNotice"
					 role="status">

					<i class="bi bi-info-circle"></i>

					<span class="verify-notice-text">
						@notice
					</span>

					<button type="button"
							class="verify-notice-close"
							id="dismissVerifyNotice"
							aria-label="Dismiss notification">

						<i class="bi bi-x-lg"></i>

					</button>

				</div>
			}

			<!-- NEXT STEPS -->
			<div class="verify-steps">

				<h2 class="verify-steps-title">
					<i class="bi bi-list-check"></i>
					What's next?
				</h2>

				<div class="verify-step">

					<span class="verify-step-number">
						1
					</span>

					<span>
						Open your email inbox
					</span>

				</div>

				<div class="verify-step">

					<span class="verify-step-number">
						2
					</span>

					<span>
						Click the verification link
					</span>

				</div>

				<div class="verify-step">

					<span class="verify-step-number">
						3
					</span>

					<span>
						Sign in to your account
					</span>

				</div>

			</div>

			<!-- SECURITY NOTICE -->
			<div class="verify-security">

				<i class="bi bi-shield-check"></i>

				<span>
					For your security, your account
					requires email verification
					before you can sign in.
				</span>

			</div>

			<!-- LOGIN BUTTON -->
			<a asp-controller="Account"
			   asp-action="Login"
			   class="verify-login-btn">

				<i class="bi bi-arrow-left"></i>

				Back to Sign In

			</a>

			<!-- FOOTER -->
			<p class="verify-footer">

				Didn't receive an email?

				<span>
					Check your spam or junk folder.
				</span>

			</p>

		</div>

	</main>

	<!-- Page JavaScript -->
	<script src="~/js/register-confirmation.js"
			asp-append-version="true"
			defer></script>

</body>
</html>
