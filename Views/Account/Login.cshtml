@model ihouse.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="login-page">

    <div class="login-container">

        <!-- LEFT PANEL -->
        <section class="login-intro">

            <!-- Logo -->
            <a asp-controller="Home"
               asp-action="Index"
               class="login-logo">

                <i class="bi bi-house-door"></i>
                <span>iHouse</span>

            </a>

            <div class="login-intro-content">

                <h1>
                    Manage your property.<br />
                    Simplify your life.
                </h1>

                <p class="login-description">
                    The smarter way to manage rooms, tenants,
                    contracts and payments in one place.
                </p>

                <!-- Feature 1 -->
                <div class="login-feature">
                    <div>
                        <strong>Easy Room Management</strong>
                        <p>Keep track of rooms and occupancy.</p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="login-feature">
                    <div>
                        <strong>Smart Invoice Tracking</strong>
                        <p>Manage rent, utilities and payments.</p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="login-feature">
                    <div>
                        <strong>Everything in One Place</strong>
                        <p>Access your property information easily.</p>
                    </div>
                </div>

                <!-- Optional illustration -->
                <div class="login-house-image">
                    <img src="~/images/houseimagebanner.png"
                         alt="iHouse property illustration" />
                </div>

            </div>

            <div class="login-intro-footer">
                Property management made simple.
            </div>

        </section>

        <!-- RIGHT PANEL -->
        <div class="login-right-column">

            <section class="login-form-panel">

                <div class="login-form-wrapper">

                    <!-- Heading -->
                    <div class="login-heading">

                        <h2>Welcome Back</h2>

                        <p>
                            Sign in to continue to your iHouse account.
                        </p>

                    </div>

                    <!-- LOGIN FORM -->
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- General validation errors -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Email -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control auth-input"
                                   placeholder="you@example.com"
                                   autocomplete="email"
                                   required />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                        <!-- Password -->
                        <div class="mb-3">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <label asp-for="Password"
                                       class="form-label mb-0">
                                    Password
                                </label>

                                <a asp-controller="Account"
                                   asp-action="ForgotPassword"
                                   class="auth-link">

                                    Forgot password?

                                </a>

                            </div>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control auth-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                        </div>

                        <!-- Remember Me -->
                        <div class="form-check mb-4">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Remember me
                            </label>

                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="btn btn-primary auth-submit w-100">

                            Sign In

                        </button>

                    </form>

                    <!-- Divider -->
                    <div class="auth-divider">
                        <span>NEW TO IHOUSE?</span>
                    </div>

                    <!-- Register link -->
                    <p class="auth-switch">

                        Don't have an account?

                        <a asp-controller="Account"
                           asp-action="Register">
                            Create an account
                        </a>

                    </p>

                </div>

            </section>

            <!-- Language selector -->
            <div class="login-language">

                <i class="bi bi-globe2"></i>

                <label for="authLanguage"
                       class="visually-hidden">
                    Language
                </label>

                <select id="authLanguage"
                        class="auth-language"
                        aria-label="Language">

                    <option value="en" selected>English</option>
                    <option value="vi">Tiếng Việt</option>

                </select>

            </div>

        </div>

    </div>

</div>