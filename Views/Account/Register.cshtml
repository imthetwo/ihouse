
@model ihouse.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "_AuthLayout";
}

<div class="register-page">
    <div class="register-card">

        <!-- Back to Login -->
        <a asp-controller="Account"
           asp-action="Login"
           class="auth-back-link">
            <i class="bi bi-arrow-left"></i>
            Back to Sign In
        </a>

        <!-- Heading -->
        <div class="register-heading">
            <h1>Create Account</h1>

            <p>
                Join iHouse to manage your property
                in one place.
            </p>
        </div>

        <!-- Register Form -->
        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <!-- Full Name -->
            <div class="mb-3">
                <label asp-for="FullName"
                       class="form-label">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control auth-input"
                       placeholder="Enter your full name"
                       autocomplete="name" />

                <span asp-validation-for="FullName"
                      class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control auth-input"
                       placeholder="you@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control auth-input"
                       placeholder="Enter your password"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control auth-input"
                       placeholder="Confirm your password"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="btn btn-primary auth-submit w-100">
                Create Account
            </button>

        </form>

        <!-- Login Link -->
        <p class="auth-switch register-switch">
            Already have an account?

            <a asp-controller="Account"
               asp-action="Login">
                Sign In
            </a>
        </p>

    </div>
</div>
