
@model ihouse.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="forgot-page">
    <div class="forgot-card">

        <a asp-controller="Account"
           asp-action="Login"
           class="auth-back-link">
            <i class="bi bi-arrow-left"></i>
            Back to Sign In
        </a>

        <div class="forgot-heading">
            <h1>Reset Password</h1>
            <p>
                Create a new password for your iHouse account.
            </p>
        </div>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control auth-input"
                       placeholder="Enter new password"
                       autocomplete="new-password"
                       required />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control auth-input"
                       placeholder="Confirm new password"
                       autocomplete="new-password"
                       required />
                        
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary auth-submit w-100">
                Reset Password
            </button>

        </form>

    </div>
</div>
