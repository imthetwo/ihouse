
@model IEnumerable<ihouse.Models.MeterReading>

@{
    ViewData["Title"] = "Meter Reading Management";
    Layout = "_AdminLayout";
    var readings = Model.ToList();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-1">Meter Reading Management</h4>
            <p class="text-muted mb-0">
                Manage electricity and water meter readings.
            </p>
        </div>

        <a asp-controller="MeterReading"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>
            Add Meter Reading
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Total Meter Readings</p>
                    <h2 class="fw-bold mb-0">@readings.Count</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Meter Reading Records</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Room</th>
                            <th>Reading Date</th>
                            <th>Electricity (kWh)</th>
                            <th>Water (m³)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reading in readings)
                        {
                            <tr>
                                <td>#@reading.Id</td>
                                <td>@reading.Room.RoomNumber</td>
                                <td>@reading.ReadingDay.ToString("dd/MM/yyyy")</td>
                                <td>@reading.ElectricityReading.ToString("N2")</td>
                                <td>@reading.WaterReading.ToString("N2")</td>

                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="MeterReading"
                                           asp-action="Edit"
                                           asp-route-id="@reading.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-controller="MeterReading"
                                                  asp-action="Delete"
                                                  asp-route-id="@reading.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this meter reading?');">

                                                @Html.AntiForgeryToken()

                                                <button class="btn btn-sm btn-outline-danger"
                                                        type="submit">
                                                    <i class="bi bi-trash"></i>
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!readings.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-5">
                                    No meter readings found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
