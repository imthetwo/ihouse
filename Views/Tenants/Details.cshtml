@model ihouse.Models.Tenant

@{
	ViewData["Title"] = "Tenant Details";
	Layout = "_AdminLayout";

	var invitationCode = TempData["InvitationCode"] as string;
	var invitationTenantId = TempData["InvitationTenantId"]?.ToString();

	bool showInvitation =
		!string.IsNullOrWhiteSpace(invitationCode) &&
		invitationTenantId == Model.Id.ToString();

	bool isLinked =
		!string.IsNullOrWhiteSpace(Model.ApplicationUserId);

	bool hasEmail =
		!string.IsNullOrWhiteSpace(Model.Email);

	var contracts = Model.ContractTenants
		.OrderByDescending(ct => ct.Contract.ContractStartDate)
		.ToList();

	bool hasActiveContract = contracts.Any(ct =>
		ct.Contract.Status.ToString() == "Active");
}

<div class="container-fluid py-4">

	<!-- PAGE HEADER -->
	<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

		<div>
			<h4 class="admin-page-title fw-bold mb-1">
				Tenant Details
			</h4>

			<p class="text-muted mb-0">
				View tenant information and manage contract invitations.
			</p>
		</div>

		<div class="d-flex gap-2">

			<a asp-controller="Tenants"
			   asp-action="Index"
			   class="btn btn-outline-secondary">
				<i class="bi bi-arrow-left me-1"></i>
				Back
			</a>

			<a asp-controller="Tenants"
			   asp-action="Edit"
			   asp-route-id="@Model.Id"
			   class="btn btn-primary">
				<i class="bi bi-pencil-square me-1"></i>
				Edit Tenant
			</a>

		</div>
	</div>

	<!-- FEEDBACK -->
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show"
			 role="alert">

			<i class="bi bi-check-circle me-2"></i>
			@TempData["Success"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert"
					aria-label="Close">
			</button>
		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show"
			 role="alert">

			<i class="bi bi-exclamation-circle me-2"></i>
			@TempData["Error"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert"
					aria-label="Close">
			</button>
		</div>
	}

	<!-- TENANT INFORMATION -->
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body p-4">

			<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

				<h5 class="fw-bold mb-0">
					<i class="bi bi-person-vcard text-primary me-2"></i>
					Tenant Information
				</h5>

				@if (isLinked)
				{
					<span class="badge bg-success-subtle text-success px-3 py-2">
						<i class="bi bi-check-circle me-1"></i>
						Account Linked
					</span>
				}
				else
				{
					<span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2">
						<i class="bi bi-clock-history me-1"></i>
						Not Linked
					</span>
				}

			</div>

			<dl class="row mb-0">

				<dt class="col-sm-3 text-muted">
					Full Name
				</dt>
				<dd class="col-sm-9 fw-semibold">
					@Model.FullName
				</dd>

				<dt class="col-sm-3 text-muted">
					Identity Number
				</dt>
				<dd class="col-sm-9">
					@Model.IdentityNumber
				</dd>

				<dt class="col-sm-3 text-muted">
					Phone
				</dt>
				<dd class="col-sm-9">
					@(Model.Phone ?? "-")
				</dd>

				<dt class="col-sm-3 text-muted">
					Email
				</dt>
				<dd class="col-sm-9">
					@(Model.Email ?? "-")
				</dd>

				<dt class="col-sm-3 text-muted">
					Account Status
				</dt>
				<dd class="col-sm-9">
					@(isLinked
						? "Linked to an iHouse account"
						: "Waiting for account connection")
				</dd>

			</dl>
		</div>
	</div>

	<!-- INVITATION CODE RESULT -->
	@if (showInvitation)
	{
		<div class="card border-0 shadow-sm mb-4">
			<div class="card-body p-4">

				<div class="d-flex align-items-center gap-2 mb-3">
					<i class="bi bi-key-fill text-primary fs-4"></i>

					<h5 class="fw-bold mb-0">
						Contract Invitation Code
					</h5>
				</div>

				<div class="alert alert-success border-0">
					<i class="bi bi-check-circle me-2"></i>
					Invitation generated successfully.

					<div class="mt-2">
						The invitation email was sent to:
						<strong>@Model.Email</strong>
					</div>

					<div class="mt-2 small">
						This code is displayed once and expires
						after 24 hours.
					</div>
				</div>

				<label for="invitationCode"
					   class="form-label fw-semibold">
					Invitation Code
				</label>

				<div class="input-group">

					<input id="invitationCode"
						   type="text"
						   class="form-control font-monospace"
						   value="@invitationCode"
						   readonly />

					<button type="button"
							id="copyInvitationButton"
							class="btn btn-outline-primary"
							onclick="copyInvitationCode()">

						<i class="bi bi-clipboard me-1"></i>
						Copy Code
					</button>

				</div>

				<p class="text-muted small mt-3 mb-0">
					The tenant must sign in with a verified email
					address and enter this code to connect
					their rental contract.
				</p>

			</div>
		</div>
	}

	<!-- RENTAL CONTRACTS -->
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body p-4">

			<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

				<h5 class="fw-bold mb-0">
					<i class="bi bi-file-earmark-text text-primary me-2"></i>
					Rental Contracts
				</h5>

				<div class="d-flex align-items-center gap-2">

					<span class="badge bg-primary-subtle text-primary">
						@contracts.Count Contract(s)
					</span>

					<a asp-controller="Contracts"
					   asp-action="Create"
					   class="btn btn-sm btn-primary">
						<i class="bi bi-plus-lg me-1"></i>
						Create Contract
					</a>

				</div>

			</div>

			@if (contracts.Any())
			{
				<div class="table-responsive">

					<table class="table align-middle mb-0">

						<thead>
							<tr>
								<th>Contract ID</th>
								<th>Room</th>
								<th>Start Date</th>
								<th>End Date</th>
								<th>Status</th>
								<th class="text-end">Invitation</th>
							</tr>
						</thead>

						<tbody>

							@foreach (var item in contracts)
							{
								bool isActive =
									item.Contract.Status.ToString() == "Active";

								bool canGenerate =
									!isLinked &&
									hasEmail &&
									isActive;

								<tr>

									<td class="fw-semibold">
										#@item.ContractId
									</td>

									<td>
										@(item.Contract.Room?.RoomNumber ?? "-")
									</td>

									<td>
										@item.Contract.ContractStartDate.ToString("dd/MM/yyyy")
									</td>

									<td>
										@item.Contract.ContractEndDate.ToString("dd/MM/yyyy")
									</td>

									<td>
										@if (isActive)
										{
											<span class="badge bg-success-subtle text-success">
												Active
											</span>
										}
										else
										{
											<span class="badge bg-secondary-subtle text-secondary">
												@item.Contract.Status
											</span>
										}
									</td>

									<td class="text-end">

										@if (canGenerate)
										{
											<form asp-controller="Tenants"
												  asp-action="GenerateInvitation"
												  method="post"
												  class="d-inline"
												  onsubmit="return confirm('Generate a new invitation code and send it to the tenant email? Previous unused codes will be invalidated.');">

												@Html.AntiForgeryToken()

												<input type="hidden"
													   name="tenantId"
													   value="@Model.Id" />

												<input type="hidden"
													   name="contractId"
													   value="@item.ContractId" />

												<button type="submit"
														class="btn btn-sm btn-outline-primary">

													<i class="bi bi-key me-1"></i>
													Generate Code
												</button>

											</form>
										}
										else if (isLinked)
										{
											<span class="badge bg-success-subtle text-success">
												Already Linked
											</span>
										}
										else if (!hasEmail)
										{
											<span class="text-warning small">
												Email Required
											</span>
										}
										else if (!isActive)
										{
											<span class="text-muted small">
												Activate Contract First
											</span>
										}

									</td>

								</tr>
							}

						</tbody>
					</table>

				</div>
			}
			else
			{
				<div class="text-center py-5">

					<i class="bi bi-file-earmark-x fs-1 text-secondary d-block mb-3"></i>

					<h6 class="fw-semibold">
						No Rental Contracts Yet
					</h6>

					<p class="text-muted mb-4">
						Create a rental contract and assign this
						tenant before generating an invitation.
					</p>

					<a asp-controller="Contracts"
					   asp-action="Create"
					   class="btn btn-primary">

						<i class="bi bi-plus-circle me-2"></i>
						Create Contract
					</a>

				</div>
			}

		</div>
	</div>

	<!-- ACCOUNT LINKING INFORMATION -->
	@if (!isLinked)
	{
		<div class="card border-0 shadow-sm">
			<div class="card-body p-4">

				<h5 class="fw-bold mb-3">
					<i class="bi bi-link-45deg text-primary me-2"></i>
					How Account Linking Works
				</h5>

				<div class="row g-3">

					<div class="col-md-4">
						<div class="border rounded-3 p-3 h-100">

							<span class="badge bg-primary-subtle text-primary mb-2">
								Step 1
							</span>

							<h6 class="fw-semibold">
								<i class="bi bi-envelope-arrow-up me-1"></i>
								Generate & Send Email
							</h6>

							<p class="text-muted small mb-0">
								Create an active contract and
								generate an invitation code.
							</p>

						</div>
					</div>

					<div class="col-md-4">
						<div class="border rounded-3 p-3 h-100">

							<span class="badge bg-primary-subtle text-primary mb-2">
								Step 2
							</span>

							<h6 class="fw-semibold">
								<i class="bi bi-envelope-check me-1"></i>
								Receive Invitation
							</h6>

							<p class="text-muted small mb-0">
								The tenant receives the invitation
								code through their registered email.
							</p>

						</div>
					</div>

					<div class="col-md-4">
						<div class="border rounded-3 p-3 h-100">

							<span class="badge bg-primary-subtle text-primary mb-2">
								Step 3
							</span>

							<h6 class="fw-semibold">
								<i class="bi bi-link-45deg me-1"></i>
								Connect Account
							</h6>

							<p class="text-muted small mb-0">
								The tenant signs in and enters
								the code to access rental information.
							</p>

						</div>
					</div>

				</div>

			</div>
		</div>
	}

</div>

@section Scripts {
	<script>
		async function copyInvitationCode() {
			const input =
				document.getElementById("invitationCode");

			const button =
				document.getElementById("copyInvitationButton");

			if (!input || !button) {
				return;
			}

			let copied = false;

			try {
				await navigator.clipboard.writeText(input.value);
				copied = true;
			}
			catch {
				input.select();
				copied = document.execCommand("copy");
			}

			if (copied) {
				button.innerHTML =
					'<i class="bi bi-check2 me-1"></i> Copied';

				button.classList.remove("btn-outline-primary");
				button.classList.add("btn-success");
			}
		}
	</script>
}
