
@model ihouse.Models.Tenant

@{
    ViewData["Title"] = "Tenant Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between mb-4">
                <h4 class="fw-bold">Tenant Details</h4>
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">Edit Tenant</a>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Identity Number</dt>
                <dd class="col-sm-9">@Model.IdentityNumber</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(Model.Email ?? "-")</dd>
            </dl>

            <hr />

            <h5 class="fw-bold mb-3">Rental Contracts</h5>

            @if (Model.ContractTenants.Any())
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Room</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ContractTenants)
                        {
                            <tr>
                                <td>@item.Contract.Room.RoomNumber</td>
                                <td>@item.Contract.ContractStartDate</td>
                                <td>@item.Contract.ContractEndDate</td>
                                <td>@item.Contract.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No rental contracts yet.</p>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary mt-3">
                Back to Tenants
            </a>
        </div>
    </div>
</div>
