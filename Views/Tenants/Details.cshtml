
@model ihouse.Models.Tenant

@{
    ViewData["Title"] = "Tenant Details";
    Layout = "_AdminLayout";

    var invitationCode = TempData["InvitationCode"] as string;
    var invitationTenantId = TempData["InvitationTenantId"]?.ToString();

    bool showInvitation =
        !string.IsNullOrWhiteSpace(invitationCode) &&
        invitationTenantId == Model.Id.ToString();

    bool isLinked =
        !string.IsNullOrWhiteSpace(Model.ApplicationUserId);

    bool hasEmail =
        !string.IsNullOrWhiteSpace(Model.Email);
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h4 class="admin-page-title fw-bold mb-1">
                Tenant Details
            </h4>

            <p class="text-muted mb-0">
                View tenant information and manage contract invitations.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Tenant
            </a>

        </div>
    </div>

    <!-- FEEDBACK -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- TENANT INFORMATION -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-vcard text-primary me-2"></i>
                    Tenant Information
                </h5>

                @if (isLinked)
                {
                    <span class="badge bg-success-subtle text-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Account Linked
                    </span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2">
                        <i class="bi bi-clock-history me-1"></i>
                        Not Linked
                    </span>
                }
            </div>

            <dl class="row mb-0">

                <dt class="col-sm-3 text-muted">
                    Full Name
                </dt>

                <dd class="col-sm-9 fw-semibold">
                    @Model.FullName
                </dd>

                <dt class="col-sm-3 text-muted">
                    Identity Number
                </dt>

                <dd class="col-sm-9">
                    @Model.IdentityNumber
                </dd>

                <dt class="col-sm-3 text-muted">
                    Phone
                </dt>

                <dd class="col-sm-9">
                    @(Model.Phone ?? "-")
                </dd>

                <dt class="col-sm-3 text-muted">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @(Model.Email ?? "-")
                </dd>

                <dt class="col-sm-3 text-muted">
                    Account Status
                </dt>

                <dd class="col-sm-9">
                    @(isLinked
                        ? "Linked to an iHouse account"
                        : "Waiting for account connection")
                </dd>

            </dl>
        </div>
    </div>

    <!-- INVITATION CODE RESULT -->
    @if (showInvitation)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-2 mb-3">

                    <i class="bi bi-key-fill text-primary fs-4"></i>

                    <h5 class="fw-bold mb-0">
                        Contract Invitation Code
                    </h5>
                </div>

                <div class="alert alert-info border-0">
                    <i class="bi bi-info-circle me-2"></i>
                    This code is shown only once.
                    Copy it and provide it securely to the tenant.
                    It expires after 24 hours.
                </div>

                <label for="invitationCode"
                       class="form-label fw-semibold">
                    Invitation Code
                </label>

                <div class="input-group">

                    <input id="invitationCode"
                           type="text"
                           class="form-control font-monospace"
                           value="@invitationCode"
                           readonly />

                    <button type="button"
                            id="copyInvitationButton"
                            class="btn btn-outline-primary"
                            onclick="copyInvitationCode()">

                        <i class="bi bi-clipboard me-1"></i>
                        Copy Code
                    </button>

                </div>

                <p class="text-muted small mt-3 mb-0">
                    The tenant must sign in with a verified
                    email address and enter this code to link
                    their rental contract.
                </p>

            </div>
        </div>
    }

    <!-- RENTAL CONTRACTS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-file-earmark-text text-primary me-2"></i>
                    Rental Contracts
                </h5>

                <span class="badge bg-primary-subtle text-primary">
                    @Model.ContractTenants.Count Contract(s)
                </span>
            </div>

            @if (Model.ContractTenants.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Contract ID</th>
                                <th>Room</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th class="text-end">Invitation</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.ContractTenants.OrderByDescending(
                                ct => ct.Contract.ContractStartDate))
                            {
                                bool canGenerate =
                                    !isLinked &&
                                    hasEmail &&
                                    item.Contract.Status.ToString() == "Active";

                                <tr>
                                    <td class="fw-semibold">
                                        #@item.ContractId
                                    </td>

                                    <td>
                                        @item.Contract.Room.RoomNumber
                                    </td>

                                    <td>
                                        @item.Contract.ContractStartDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.Contract.ContractEndDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (item.Contract.Status.ToString() == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                @item.Contract.Status
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        @if (canGenerate)
                                        {
                                            <form asp-controller="Tenants"
                                                  asp-action="GenerateInvitation"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="tenantId"
                                                       value="@Model.Id" />

                                                <input type="hidden"
                                                       name="contractId"
                                                       value="@item.ContractId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary"
                                                        onclick="return confirm('Generate a new invitation code? Previous unused codes will be invalidated.');">

                                                    <i class="bi bi-key me-1"></i>
                                                    Generate Code
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                @if (isLinked)
                                                {
                                                    <text>Already linked</text>
                                                }
                                                else if (!hasEmail)
                                                {
                                                    <text>Email required</text>
                                                }
                                                else
                                                {
                                                    <text>Not available</text>
                                                }
                                            </span>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-file-earmark-x fs-1 text-secondary d-block mb-2"></i>

                    <h6 class="fw-semibold">
                        No rental contracts yet
                    </h6>

                    <p class="text-muted mb-0">
                        Assign a contract to this tenant
                        before generating an invitation.
                    </p>

                </div>
            }
        </div>
    </div>

    <!-- ACCOUNT LINKING INFORMATION -->
    @if (!isLinked)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-link-45deg text-primary me-2"></i>
                    How Account Linking Works
                </h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 h-100">
                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Step 1
                            </span>

                            <h6 class="fw-semibold">
                                Generate Code
                            </h6>

                            <p class="text-muted small mb-0">
                                Select the active contract
                                and create an invitation code.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 h-100">
                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Step 2
                            </span>

                            <h6 class="fw-semibold">
                                Share with Tenant
                            </h6>

                            <p class="text-muted small mb-0">
                                Give the invitation code to
                                the intended tenant securely.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 h-100">
                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Step 3
                            </span>

                            <h6 class="fw-semibold">
                                Connect Account
                            </h6>

                            <p class="text-muted small mb-0">
                                Tenant signs in and enters
                                the code to access rental information.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        async function copyInvitationCode() {
            const input = document.getElementById("invitationCode");
            const button = document.getElementById("copyInvitationButton");

            if (!input || !button) return;

            try {
                await navigator.clipboard.writeText(input.value);

                button.innerHTML =
                    '<i class="bi bi-check2 me-1"></i> Copied';

                button.classList.remove("btn-outline-primary");
                button.classList.add("btn-success");
            }
            catch {
                input.select();
                document.execCommand("copy");
            }
        }
    </script>
}
