
@model IEnumerable<ihouse.Models.Invoice>
@using System.Globalization
@using ihouse.Models.Enums

@{
    ViewData["Title"] = "Invoice Management";
    Layout = "_AdminLayout";

    var invoices = Model.ToList();
    var usd = CultureInfo.GetCultureInfo("en-US");

    bool isAdmin = User.IsInRole("Admin");

    int totalInvoices = invoices.Count;

    int unpaid = invoices.Count(i =>
        i.Status == InvoiceStatus.Unpaid);

    int partial = invoices.Count(i =>
        i.Status == InvoiceStatus.PartiallyPaid);

    int paid = invoices.Count(i =>
        i.Status == InvoiceStatus.Paid);
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="admin-page-header">

        <h4 class="admin-page-title">
            Invoice Management
        </h4>

        <a asp-controller="Invoices"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Create Invoice
        </a>

    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="status">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">
                        Total Invoices
                    </p>

                    <h2 class="fw-bold mb-0">
                        @totalInvoices
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">
                        Unpaid
                    </p>

                    <h2 class="fw-bold text-danger mb-0">
                        @unpaid
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">
                        Partially Paid
                    </p>

                    <h2 class="fw-bold text-warning mb-0">
                        @partial
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">
                        Paid
                    </p>

                    <h2 class="fw-bold text-success mb-0">
                        @paid
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- INVOICE TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        Invoice List
                    </h5>

                    <p class="text-muted small mb-0">
                        View and manage rental invoices.
                    </p>
                </div>

                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    @totalInvoices Invoices
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Invoice ID</th>
                            <th>Contract</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in invoices)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    #@invoice.Id
                                </td>

                                <td>
                                    #@invoice.ContractId
                                </td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @invoice.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="fw-semibold">
                                    @invoice.TotalAmount.ToString("C2", usd)
                                </td>

                                <td>
                                    @if (invoice.Status == InvoiceStatus.Paid)
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (
                                        invoice.Status ==
                                        InvoiceStatus.PartiallyPaid)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unpaid
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <!-- DETAILS -->
                                        <a asp-controller="Invoices"
                                           asp-action="Details"
                                           asp-route-id="@invoice.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            Details
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <!-- EDIT -->
                                            <a asp-controller="Invoices"
                                               asp-action="Edit"
                                               asp-route-id="@invoice.Id"
                                               class="btn btn-sm btn-outline-secondary">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            <!-- DELETE -->
                                            <a asp-controller="Invoices"
                                               asp-action="Delete"
                                               asp-route-id="@invoice.Id"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash me-1"></i>
                                                Delete
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                        @if (!invoices.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-receipt fs-2 d-block mb-2"></i>

                                    No invoices found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
