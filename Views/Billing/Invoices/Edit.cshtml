
@model ihouse.ViewModels.Invoice.InvoiceEditViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Edit Invoice";
    Layout = "_AdminLayout";

    var usd = CultureInfo.GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <!-- BACK -->
    <div class="mb-4">
        <a asp-controller="Invoices"
           asp-action="Index"
           class="text-decoration-none text-muted small">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- HEADER -->
                    <div class="mb-4">

                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                                <i class="bi bi-pencil-square fs-4"></i>
                            </div>

                            <div>
                                <h4 class="fw-bold mb-1">
                                    Edit Invoice #@Model.Id
                                </h4>

                                <p class="text-muted small mb-0">
                                    Update invoice information.
                                </p>
                            </div>

                        </div>

                    </div>

                    <form asp-controller="Invoices"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ContractId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <!-- CONTRACT -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Contract
                            </label>

                            <input type="text"
                                   class="form-control bg-light"
                                   value="Contract #@Model.ContractId"
                                   readonly />

                            <div class="form-text">
                                The related contract cannot be changed.
                            </div>

                        </div>

                        <!-- INVOICE DATE -->
                        <div class="mb-4">

                            <label asp-for="InvoiceDate"
                                   class="form-label fw-semibold">
                                Invoice Date
                            </label>

                            <input asp-for="InvoiceDate"
                                   asp-format="{0:yyyy-MM-dd}"
                                   type="date"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="InvoiceDate"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- DUE DATE -->
                        <div class="mb-4">

                            <label asp-for="DueDate"
                                   class="form-label fw-semibold">
                                Due Date
                            </label>

                            <input asp-for="DueDate"
                                   asp-format="{0:yyyy-MM-dd}"
                                   type="date"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="DueDate"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- RENT -->
                        <div class="mb-4">

                            <label asp-for="RentAmount"
                                   class="form-label fw-semibold">
                                Monthly Rent (USD)
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="RentAmount"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="RentAmount"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Changes to the rental amount will
                                update the invoice total.
                                Other existing invoice items are preserved.
                            </div>

                        </div>

                        <!-- INFORMATION -->
                        <div class="alert alert-light border rounded-3 mb-4">

                            <div class="d-flex gap-2">

                                <i class="bi bi-info-circle text-primary"></i>

                                <div class="small text-muted">
                                    Editing is only available before
                                    payment activity has been recorded.

                                    The invoice must remain within
                                    its contract period.
                                </div>

                            </div>

                        </div>

                        <!-- ACTIONS -->
                        <div class="d-flex justify-content-end flex-wrap gap-2">

                            <a asp-controller="Invoices"
                               asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4">

                                <i class="bi bi-check-circle me-2"></i>
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
