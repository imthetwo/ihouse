
@model ihouse.Models.Payment
@using System.Globalization

@{
    ViewData["Title"] = "Payment Details";
    Layout = "_AdminLayout";

    var usd = CultureInfo.GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-controller="Payment"
           asp-action="Index"
           class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Payments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- HEADER -->
                    <div class="text-center mb-4">

                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success mb-3 icon-64">
                            <i class="bi bi-check-circle fs-2"></i>
                        </div>

                        <h4 class="fw-bold mb-2">
                            Payment Recorded
                        </h4>

                        <p class="text-muted mb-2">
                            Payment #@Model.Id
                        </p>

                        <h2 class="fw-bold text-success mb-0">
                            @Model.Amount.ToString("C2", usd)
                        </h2>

                    </div>

                    <hr class="my-4" />

                    <!-- PAYMENT INFORMATION -->
                    <h6 class="fw-bold mb-4">
                        Transaction Details
                    </h6>

                    <div class="row g-4">

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Payment ID
                            </small>

                            <strong>
                                #@Model.Id
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Invoice
                            </small>

                            <strong>
                                #@Model.InvoiceId
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Contract
                            </small>

                            <strong>
                                @(Model.Invoice != null
                                    ? "#" + Model.Invoice.ContractId
                                    : "—")
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Payment Method
                            </small>

                            <strong>
                                @Model.PaymentMethod
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Payment Date (UTC)
                            </small>

                            <strong>
                                @Model.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block mb-1">
                                Transaction Reference
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.TransactionCode)
                                    ? "—"
                                    : Model.TransactionCode)
                            </strong>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                        <div>
                            <span class="text-muted small">
                                Recorded Amount
                            </span>

                            <h5 class="fw-bold mb-0 mt-1">
                                @Model.Amount.ToString("C2", usd)
                            </h5>
                        </div>

                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>
                            Recorded
                        </span>

                    </div>

                    <div class="mt-4">
                        <a asp-controller="Payment"
                           asp-action="Index"
                           class="btn btn-primary rounded-3 w-100 py-3">
                            Back to Payment Management
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
