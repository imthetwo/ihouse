
@model ihouse.ViewModels.Maintenance.MaintenanceFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Maintenance Request";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-controller="Maintenance" asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Maintenance
        </a>

        <h4 class="fw-bold mt-3 mb-1">
            Create Maintenance Request
        </h4>
        <p class="text-muted">
            Register a new room maintenance request.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Maintenance"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="RoomId"
                               class="form-label fw-semibold">
                            Room
                        </label>

                        <select asp-for="RoomId"
                                asp-items="@(ViewBag.RoomOptions as IEnumerable<SelectListItem>)"
                                class="form-select">
                            <option value="0">-- Select Room --</option>
                        </select>

                        <span asp-validation-for="RoomId"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TenantId"
                               class="form-label fw-semibold">
                            Tenant
                        </label>

                        <select asp-for="TenantId"
                                asp-items="@(ViewBag.TenantOptions as IEnumerable<SelectListItem>)"
                                class="form-select">
                            <option value="0">-- Select Tenant --</option>
                        </select>

                        <span asp-validation-for="TenantId"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Describe the maintenance issue..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                </div>

                <div class="alert alert-info mt-4">
                    New maintenance requests start with Pending status.
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Maintenance"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-2"></i>
                        Create Request
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>
