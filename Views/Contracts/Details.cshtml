
@model ihouse.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
    Layout = "_AdminLayout";

    var usd = System.Globalization.CultureInfo
        .GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">
                Contract #@Model.Id
            </h4>

            <div class="row g-4">

                <div class="col-md-6">
                    <p class="text-muted mb-1">Room</p>
                    <h6>@Model.Room.RoomNumber</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Status</p>
                    <h6>@Model.Status</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Start Date</p>
                    <h6>@Model.ContractStartDate</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">End Date</p>
                    <h6>@Model.ContractEndDate</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Monthly Rent</p>
                    <h6>@Model.RentPrice.ToString("C2", usd)</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Deposit</p>
                    <h6>@Model.DepositAmount.ToString("C2", usd)</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Payment Method</p>
                    <h6>@Model.PaymentMethod</h6>
                </div>

            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Tenants</h5>

            @foreach (var item in Model.ContractTenants)
            {
                <div class="border rounded p-3 mb-2">
                    <strong>@item.Tenant.FullName</strong>

                    @if (item.IsPrimaryTenant)
                    {
                        <span class="badge bg-primary ms-2">
                            Primary Tenant
                        </span>
                    }

                    <div class="small text-muted mt-1">
                        @(item.Tenant.Email ?? "No email")
                    </div>
                </div>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary mt-4">
                Back to Contracts
            </a>

        </div>
    </div>

</div>
