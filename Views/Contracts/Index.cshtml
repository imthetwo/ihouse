
@model IEnumerable<ihouse.Models.Contract>
@using ihouse.Models.Enums

@{
    ViewData["Title"] = "Contract Management";
    Layout = "_AdminLayout";

    var usd = System.Globalization.CultureInfo
        .GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <h4 class="fw-bold mb-0">Contract Management</h4>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Contract
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Room</th>
                            <th>Primary Tenant</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Monthly Rent</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var contract in Model)
                        {
                            var primary = contract.ContractTenants
                                .FirstOrDefault(ct => ct.IsPrimaryTenant);

                            <tr>
                                <td>#@contract.Id</td>

                                <td>@contract.Room.RoomNumber</td>

                                <td>
                                    @(primary?.Tenant.FullName ?? "-")
                                </td>

                                <td>@contract.ContractStartDate</td>
                                <td>@contract.ContractEndDate</td>

                                <td>
                                    @contract.RentPrice.ToString("C ", usd)
                                </td>

                                <td>
                                    @if (contract.Status == ContractStatus.Active)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (contract.Status == ContractStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Terminated
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@contract.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    @if (contract.Status != ContractStatus.Terminated)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="Terminate"
                                              asp-route-id="@contract.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Terminate this contract?');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Terminate
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">
                                    No contracts found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>
