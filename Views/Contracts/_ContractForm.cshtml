@model ihouse.ViewModels.Contract.ContractFormViewModel
@using ihouse.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    string selectedTenantName =
        (string?)ViewBag.SelectedTenantName ?? "";

    var paymentMethods = new List<SelectListItem>
    {
        new SelectListItem
        {
            Text = "Cash",
            Value = ((int)PaymentMethod.Cash).ToString()
        },
        new SelectListItem
        {
            Text = "PayPal",
            Value = ((int)PaymentMethod.PayPal).ToString()
        }
    };
}

<link rel="stylesheet"
      href="~/css/contract-form.css"
      asp-append-version="true" />

<div asp-validation-summary="All"
     class="text-danger mb-3"></div>

<div class="row g-3">

    <!-- ROOM -->
    <div class="col-md-6">

        <label asp-for="RoomId"
               class="form-label fw-semibold">
            Room
        </label>

        <select asp-for="RoomId"
                asp-items="(IEnumerable<SelectListItem>)ViewBag.RoomOptions"
                class="form-select">

            <option value="0">
                -- Select Room --
            </option>

        </select>

        <span asp-validation-for="RoomId"
              class="text-danger small"></span>

    </div>

    <!-- PRIMARY TENANT -->
    <div class="col-md-6">

        <label for="tenantSearch"
               class="form-label fw-semibold">
            Primary Tenant
        </label>

        <input asp-for="PrimaryTenantId"
               type="hidden" />

        <div class="position-relative"
             id="tenantSearchContainer"
             data-search-url="@Url.Action("SearchTenants", "Contracts")">

            <div class="input-group">

                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search"
                       id="tenantSearch"
                       class="form-control"
                       value="@selectedTenantName"
                       placeholder="Search ID, name, phone or identity number..."
                       autocomplete="off"
                       aria-autocomplete="list"
                       aria-controls="tenantSearchResults"
                       aria-expanded="false" />

            </div>

            <div id="tenantSearchResults"
                 class="list-group position-absolute w-100 shadow-sm"
                 role="listbox"
                 aria-label="Tenant search results">
            </div>

        </div>

        <div class="form-text">
            Search by tenant ID, full name, phone or identity number.
        </div>

        <span asp-validation-for="PrimaryTenantId"
              class="text-danger small"></span>

    </div>

    <!-- START DATE -->
    <div class="col-md-6">

        <label asp-for="ContractStartDate"
               class="form-label fw-semibold">
            Start Date
        </label>

        <input asp-for="ContractStartDate"
               type="date"
               class="form-control contract-date-input" />

        <span asp-validation-for="ContractStartDate"
              class="text-danger small"></span>

    </div>

    <!-- END DATE -->
    <div class="col-md-6">

        <label asp-for="ContractEndDate"
               class="form-label fw-semibold">
            End Date
        </label>

        <input asp-for="ContractEndDate"
               type="date"
               class="form-control contract-date-input" />

        <span asp-validation-for="ContractEndDate"
              class="text-danger small"></span>

    </div>

    <!-- MONTHLY RENT -->
    <div class="col-md-6">

        <label asp-for="RentPrice"
               class="form-label fw-semibold">
            Monthly Rent (USD)
        </label>

        <div class="input-group">

            <span class="input-group-text">
                $
            </span>

            <input asp-for="RentPrice"
                   type="number"
                   min="1"
                   max="2000"
                   step="0.01"
                   class="form-control" />

        </div>

        <span asp-validation-for="RentPrice"
              class="text-danger small"></span>

    </div>

    <!-- DEPOSIT -->
    <div class="col-md-6">

        <label asp-for="DepositAmount"
               class="form-label fw-semibold">
            Deposit (USD)
        </label>

        <div class="input-group">

            <span class="input-group-text">
                $
            </span>

            <input asp-for="DepositAmount"
                   type="number"
                   min="0"
                   max="4000"
                   step="0.01"
                   class="form-control" />

        </div>

        <span asp-validation-for="DepositAmount"
              class="text-danger small"></span>

    </div>

    <!-- PAYMENT METHOD -->
    <div class="col-md-6">

        <label asp-for="PaymentMethod"
               class="form-label fw-semibold">
            Payment Method
        </label>

        <select asp-for="PaymentMethod"
                asp-items="paymentMethods"
                class="form-select">
        </select>

        <div class="form-text">
            Select the preferred payment method for this contract.
        </div>

        <span asp-validation-for="PaymentMethod"
              class="text-danger small"></span>

    </div>

    <!-- CONTRACT STATUS -->
    <div class="col-md-6">

        <label asp-for="Status"
               class="form-label fw-semibold">
            Contract Status
        </label>

        <select asp-for="Status"
                asp-items="Html.GetEnumSelectList<ContractStatus>()"
                class="form-select">
        </select>

        <span asp-validation-for="Status"
              class="text-danger small"></span>

    </div>

</div>

<script src="~/js/contract-form.js"
        asp-append-version="true"></script>