@{
    ViewData["Title"] = "Confirm PayPal Payment";
    Layout = "_TenantLayout";

    string orderId =
        Convert.ToString(ViewBag.OrderId) ?? "";

    int invoiceId =
        Convert.ToInt32(ViewBag.InvoiceId);

    decimal amount =
        Convert.ToDecimal(ViewBag.Amount);
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-4">
                        <div class="d-inline-flex
                            align-items-center
                            justify-content-center
                            rounded-circle
                            bg-primary bg-opacity-10"
                             style="width:80px;height:80px;">

                            <i class="bi bi-shield-check text-primary"
                               style="font-size:38px;">
                            </i>

                        </div>
                    </div>

                    <h3 class="fw-bold mb-3">
                        Confirming Your Payment
                    </h3>

                    <p class="text-muted mb-4">
                        Please wait while we confirm your
                        payment and update your invoice.
                    </p>

                    <div class="bg-light rounded-3 p-4 mb-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            mb-3">

                            <span class="text-muted">
                                Invoice
                            </span>

                            <strong>
                                #@invoiceId
                            </strong>

                        </div>

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            mb-3">

                            <span class="text-muted">
                                Payment Method
                            </span>

                            <strong>
                                PayPal Sandbox
                            </strong>

                        </div>

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <span class="text-muted">
                                Amount
                            </span>

                            <strong class="text-primary">
                                $@amount.ToString("N2") USD
                            </strong>

                        </div>

                    </div>

                    <div id="paypalProcessing"
                         class="mb-4">

                        <div class="spinner-border text-primary"
                             role="status">

                            <span class="visually-hidden">
                                Processing...
                            </span>

                        </div>

                        <p class="text-muted mt-3 mb-0">
                            Processing your payment...
                        </p>

                    </div>

                    <form id="paypalCaptureForm"
                          asp-controller="PayPal"
                          asp-action="Capture"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="orderId"
                               value="@orderId" />

                        <button id="captureButton"
                                type="submit"
                                class="btn btn-primary w-100 py-3">

                            <i class="bi bi-check-circle me-2"></i>
                            Continue

                        </button>

                    </form>

                    <p class="text-muted small mt-3 mb-0">
                        Please do not close this page
                        while your payment is being confirmed.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/paypal-return.js"
        asp-append-version="true"></script>