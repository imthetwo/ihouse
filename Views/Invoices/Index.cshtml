
@model IEnumerable<ihouse.Models.Invoice>

@using System.Globalization
@using ihouse.Models.Enums

@{
    ViewData["Title"] = "Invoice Management";
    Layout = "_AdminLayout";

    var usd = CultureInfo.GetCultureInfo("en-US");
    var invoices = Model.ToList();

    var totalInvoices = invoices.Count;
    var unpaidInvoices = invoices.Count(i =>
        i.Status == InvoiceStatus.Unpaid);

    var partiallyPaidInvoices = invoices.Count(i =>
        i.Status == InvoiceStatus.PartiallyPaid);

    var paidInvoices = invoices.Count(i =>
        i.Status == InvoiceStatus.Paid);
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-end mb-4">
        <a asp-controller="Invoices"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Create Invoice
        </a>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Total Invoices</p>
                    <h3 class="fw-bold mb-0">@totalInvoices</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Unpaid</p>
                    <h3 class="fw-bold text-danger mb-0">
                        @unpaidInvoices
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Partially Paid</p>
                    <h3 class="fw-bold text-warning mb-0">
                        @partiallyPaidInvoices
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Paid</p>
                    <h3 class="fw-bold text-success mb-0">
                        @paidInvoices
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- INVOICE TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Invoice List</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Invoice ID</th>
                            <th>Contract</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr>
                                <td>#@invoice.Id</td>

                                <td>#@invoice.ContractId</td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @invoice.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="fw-semibold">
                                    @invoice.TotalAmount.ToString("C2", usd)
                                </td>

                                <td>
                                    @if (invoice.Status == InvoiceStatus.Paid)
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (invoice.Status == InvoiceStatus.PartiallyPaid)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unpaid
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!invoices.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">
                                    No invoices found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
