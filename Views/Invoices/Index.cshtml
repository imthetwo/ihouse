
@model IEnumerable<ihouse.Models.Invoice>
@using System.Globalization
@using ihouse.Models.Enums

@{
    ViewData["Title"] = "Invoice Management";
    Layout = "_AdminLayout";

    var invoices = Model.ToList();
    var usd = CultureInfo.GetCultureInfo("en-US");

    int totalInvoices = invoices.Count;
    int unpaid = invoices.Count(i => i.Status == InvoiceStatus.Unpaid);
    int partial = invoices.Count(i => i.Status == InvoiceStatus.PartiallyPaid);
    int paid = invoices.Count(i => i.Status == InvoiceStatus.Paid);
}

<div class="container-fluid py-4">

    
<!-- PAGE HEADER -->
<div class="admin-page-header">

    <h4 class="admin-page-title">
        Invoice Management
    </h4>

    <a asp-controller="Invoices"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Create Invoice
    </a>

</div>


    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Total Invoices</p>
                    <h2 class="fw-bold mb-0">@totalInvoices</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Unpaid</p>
                    <h2 class="fw-bold text-danger mb-0">@unpaid</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Partially Paid</p>
                    <h2 class="fw-bold text-warning mb-0">@partial</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Paid</p>
                    <h2 class="fw-bold text-success mb-0">@paid</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- INVOICE TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Invoice List</h5>

            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Invoice ID</th>
                            <th>Contract</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr>
                                <td>#@invoice.Id</td>

                                <td>#@invoice.ContractId</td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @invoice.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="fw-semibold">
                                    @invoice.TotalAmount.ToString("C2", usd)
                                </td>

                                <td>
                                    @if (invoice.Status == InvoiceStatus.Paid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.Status == InvoiceStatus.PartiallyPaid)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!invoices.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">
                                    <i class="bi bi-receipt fs-2 d-block mb-2"></i>
                                    No invoices found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
