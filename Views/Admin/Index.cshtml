
@model ihouse.ViewModels.Admin.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome to iHouse Property Management.
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("MMMM dd, yyyy", usd)
        </div>

    </div>


    <!-- ROOM STATISTICS -->
    <div class="row g-4 mb-4">

        <!-- TOTAL ROOMS -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Total Rooms
                        </span>

                        <i class="bi bi-buildings fs-3 text-primary"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        @Model.TotalRooms
                    </h2>

                    <small class="text-muted">
                        All registered rooms
                    </small>

                </div>
            </div>
        </div>


        <!-- OCCUPIED ROOMS -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Occupied Rooms
                        </span>

                        <i class="bi bi-people fs-3 text-success"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        @Model.OccupiedRooms
                    </h2>

                    <small class="text-muted">
                        Rooms currently occupied
                    </small>

                </div>
            </div>
        </div>


        <!-- AVAILABLE ROOMS -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Available Rooms
                        </span>

                        <i class="bi bi-door-open fs-3 text-info"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        @Model.AvailableRooms
                    </h2>

                    <small class="text-muted">
                        Ready for new tenants
                    </small>

                </div>
            </div>
        </div>


        <!-- MAINTENANCE ROOMS -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Maintenance Rooms
                        </span>

                        <i class="bi bi-tools fs-3 text-warning"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        @Model.MaintenanceRooms
                    </h2>

                    <small class="text-muted">
                        Rooms under maintenance
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- FINANCIAL STATISTICS -->
    <div class="row g-4 mb-4">

        <!-- MONTHLY REVENUE -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Monthly Revenue
                        </span>

                        <i class="bi bi-currency-dollar fs-3 text-success"></i>
                    </div>

                    <h2 class="fw-bold text-success mb-1">
                        @Model.MonthlyRevenue.ToString("C2", usd)
                    </h2>

                    <small class="text-muted">
                        Total payments received this month
                    </small>

                </div>
            </div>
        </div>


        <!-- UNPAID INVOICES -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Unpaid Invoices
                        </span>

                        <i class="bi bi-receipt fs-3 text-warning"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        @Model.UnpaidInvoices
                    </h2>

                    <small class="text-muted">
                        Outstanding invoices
                    </small>

                </div>
            </div>
        </div>


        <!-- OVERDUE INVOICES -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-medium">
                            Overdue Invoices
                        </span>

                        <i class="bi bi-exclamation-triangle fs-3 text-danger"></i>
                    </div>

                    <h2 class="fw-bold text-danger mb-1">
                        @Model.OverdueInvoices
                    </h2>

                    <small class="text-muted">
                        Invoices past their due date
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- MANAGEMENT MODULES -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-2">
                <i class="bi bi-grid-1x2 me-2 text-primary"></i>
                Property Management
            </h5>

            <p class="text-muted mb-4">
                Manage your rooms, tenants, contracts, invoices and payments.
            </p>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-door-closed fs-4 text-primary"></i>
                        <h6 class="fw-semibold mt-3">
                            Room Management
                        </h6>
                        <p class="text-muted small mb-0">
                            Manage room information, availability and pricing.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-people fs-4 text-primary"></i>
                        <h6 class="fw-semibold mt-3">
                            Tenant Management
                        </h6>
                        <p class="text-muted small mb-0">
                            View and manage tenant information.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-file-earmark-text fs-4 text-primary"></i>
                        <h6 class="fw-semibold mt-3">
                            Contract Management
                        </h6>
                        <p class="text-muted small mb-0">
                            Create and track rental contracts.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-receipt fs-4 text-primary"></i>
                        <h6 class="fw-semibold mt-3">
                            Invoice Management
                        </h6>
                        <p class="text-muted small mb-0">
                            Track invoices and outstanding payments.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>
