@{
	var accountName = User.Identity?.Name ?? "Tenant";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />

	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />

	<title>@ViewData["Title"] - iHouse</title>

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

	<link rel="stylesheet"
		  href="~/css/site.css"
		  asp-append-version="true" />

	<link rel="stylesheet"
		  href="~/css/tenant.css"
		  asp-append-version="true" />


	@await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>

<body class="tenant-body">

	<!-- =====================================
         TENANT HEADER
         ===================================== -->

	<header class="ih-tenant-header">

		<div class="ih-tenant-header-inner">

			
			<!-- BRAND -->
			<partial name="_Brand" />

			<!-- ACCOUNT DROPDOWN -->
			<div class="dropdown">

				<button type="button"
						class="ih-account-button"
						data-bs-toggle="dropdown"
						aria-expanded="false"
						aria-label="Open account menu">

					<span class="ih-account-avatar">
						<i class="bi bi-person"></i>
					</span>

					<span class="ih-account-info">
						<span class="ih-account-name">
							@accountName
						</span>

						<span class="ih-account-role">
							Tenant Account
						</span>
					</span>

					<i class="bi bi-chevron-down text-secondary small"></i>

				</button>

				<ul class="dropdown-menu dropdown-menu-end ih-account-menu">

					<!-- ACCOUNT INFORMATION -->
					<li class="px-3 py-2">

						<div class="fw-semibold text-truncate">
							@accountName
						</div>

						<small class="text-muted">
							Tenant
						</small>

					</li>

					<li>
						<hr class="dropdown-divider" />
					</li>

					<!-- DASHBOARD -->
					<li>
						<a asp-controller="TenantDashboard"
						   asp-action="Index"
						   class="dropdown-item">

							<i class="bi bi-grid-1x2 me-2"></i>
							My Dashboard

						</a>
					</li>

					<li>
						<hr class="dropdown-divider" />
					</li>

					<!-- LOGOUT -->
					<li>

						<form asp-controller="Account"
							  asp-action="Logout"
							  method="post">

							@Html.AntiForgeryToken()

							<button type="submit"
									class="dropdown-item text-danger">

								<i class="bi bi-box-arrow-right me-2"></i>
								Logout

							</button>

						</form>

					</li>

				</ul>

			</div>

		</div>

	</header>

	<!-- =====================================
         MAIN CONTENT
         ===================================== -->

	<main class="ih-tenant-main">
		@RenderBody()
	</main>

	<!-- =====================================
         FOOTER
         ===================================== -->

	<footer class="ih-tenant-footer">
		&copy; @DateTime.Now.Year iHouse.
		All rights reserved.
	</footer>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<script src="~/js/site.js" asp-append-version="true" defer></script>
	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
