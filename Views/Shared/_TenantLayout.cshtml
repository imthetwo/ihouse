
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - iHouse Tenant</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tenant.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="tenant-body">

    <header class="tenant-navbar">
        <a asp-controller="Home"
           asp-action="Index"
           class="tenant-brand">
            <span class="tenant-brand-icon">⌂</span>
            <span>iHouse</span>
        </a>

        <nav class="tenant-nav">
            <a asp-controller="TenantPortal"
               asp-action="Index"
               class="tenant-nav-link">
                <i class="bi bi-grid"></i>
                Dashboard
            </a>

            <a asp-controller="TenantPortal"
               asp-action="MyRoom"
               class="tenant-nav-link">
                <i class="bi bi-door-open"></i>
                My Room
            </a>

            <a asp-controller="TenantPortal"
               asp-action="MyContract"
               class="tenant-nav-link">
                <i class="bi bi-file-earmark-text"></i>
                My Contract
            </a>

            <a asp-controller="TenantPortal"
               asp-action="MyInvoices"
               class="tenant-nav-link">
                <i class="bi bi-receipt"></i>
                My Invoices
            </a>

            <a asp-controller="TenantPortal"
               asp-action="Payments"
               class="tenant-nav-link">
                <i class="bi bi-credit-card"></i>
                Payments
            </a>

            <a asp-controller="TenantPortal"
               asp-action="Maintenance"
               class="tenant-nav-link">
                <i class="bi bi-tools"></i>
                Maintenance
            </a>

            <a asp-controller="TenantPortal"
               asp-action="Profile"
               class="tenant-nav-link">
                <i class="bi bi-person-circle"></i>
                My Profile
            </a>
        </nav>
    </header>

    <main class="tenant-content">
        <div class="tenant-page-heading">
            <h1>@(ViewData["Title"] ?? "Dashboard")</h1>
            <p>Manage your rental information in one place.</p>
        </div>

        @RenderBody()
    </main>

    <footer class="tenant-footer">
        &copy; @DateTime.Now.Year iHouse. All rights reserved.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
