
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - iHouse</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">

    <div class="admin-shell">

        <aside class="admin-sidebar">
            <a asp-controller="Home"
               asp-action="Index"
               class="admin-brand">
                <span class="admin-brand-icon">⌂</span>
                <span>iHouse</span>
            </a>

            <div class="sidebar-heading">MAIN MENU</div>

            <nav class="admin-nav">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Room"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-door-open"></i>
                    <span>Rooms</span>
                </a>

                <a asp-controller="Tenant"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-people"></i>
                    <span>Tenants</span>
                </a>

                <a asp-controller="Contract"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Contracts</span>
                </a>

                <a asp-controller="Invoice"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-receipt"></i>
                    <span>Invoices</span>
                </a>

                <a asp-controller="Payment"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>
                </a>

                <a asp-controller="MeterReading"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-speedometer2"></i>
                    <span>Meter Readings</span>
                </a>

                <a asp-controller="ServicePrice"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-tags"></i>
                    <span>Service Prices</span>
                </a>

                <a asp-controller="Maintenance"
                   asp-action="Index"
                   class="admin-nav-link">
                    <i class="bi bi-tools"></i>
                    <span>Maintenance</span>
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                Property Management System
            </div>
        </aside>

        <div class="admin-main">

            <header class="admin-topbar">
                <div>
                    <h1 class="admin-page-title">
                        @(ViewData["Title"] ?? "Dashboard")
                    </h1>
                    <p class="admin-page-subtitle">
                        iHouse Management System
                    </p>
                </div>

                <div class="admin-user">
                    <div class="admin-avatar">
                        <i class="bi bi-person"></i>
                    </div>
                    <div>
                        <div class="admin-user-name">Account</div>
                        <div class="admin-user-role">Admin / Staff</div>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; @DateTime.Now.Year iHouse. All rights reserved.
            </footer>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
