
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - iHouse</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-body">

    <div class="admin-shell">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <!-- BRAND -->
            <a asp-controller="Admin"
               asp-action="Index"
               class="admin-brand">

                <span class="admin-brand-icon">⌂</span>
                <span>iHouse</span>
            </a>

            <div class="sidebar-heading">
                MAIN MENU
            </div>

            <!-- NAVIGATION -->
            <nav class="admin-nav">

                <!-- DASHBOARD -->
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <!-- ROOMS -->
                <a asp-controller="Rooms"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-door-open"></i>
                    <span>Rooms</span>
                </a>

                <!-- TENANTS -->
                <a asp-controller="Tenant"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-people"></i>
                    <span>Tenants</span>
                </a>

                <!-- CONTRACTS -->
                <a asp-controller="Contract"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-file-earmark-text"></i>
                    <span>Contracts</span>
                </a>

                <!-- INVOICES -->
                <a asp-controller="Invoice"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-receipt"></i>
                    <span>Invoices</span>
                </a>

                <!-- PAYMENTS -->
                <a asp-controller="Payment"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>
                </a>

                <!-- METER READINGS -->
                <a asp-controller="MeterReading"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-speedometer2"></i>
                    <span>Meter Readings</span>
                </a>

                <!-- SERVICE PRICES -->
                <a asp-controller="ServicePrice"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-tags"></i>
                    <span>Service Prices</span>
                </a>

                <!-- MAINTENANCE -->
                <a asp-controller="Maintenance"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="bi bi-tools"></i>
                    <span>Maintenance</span>
                </a>

            </nav>

            <!-- SIDEBAR FOOTER -->
            <div class="admin-sidebar-footer">
                Property Management System
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div>
                    <h1 class="admin-page-title">
                        @(ViewData["Title"] ?? "Dashboard")
                    </h1>

                    <p class="admin-page-subtitle">
                        iHouse Management System
                    </p>
                </div>

                <!-- USER INFORMATION -->
                <div class="admin-user">

                    <div class="admin-avatar">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <div class="admin-user-name">
                            @(User.Identity?.Name ?? "Account")
                        </div>

                        <div class="admin-user-role">
                            @if (User.IsInRole("Admin"))
                            {
                                <span>Admin</span>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <span>Staff</span>
                            }
                            else
                            {
                                <span>User</span>
                            }
                        </div>
                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="admin-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="admin-footer">
                &copy; @DateTime.Now.Year iHouse.
                All rights reserved.
            </footer>

        </div>

    </div>

    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
