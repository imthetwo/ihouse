@{
	var currentController =
		ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

	var accountName = User.Identity?.Name ?? "Account";

	var accountRole = User.IsInRole("Admin")
		? "Admin"
		: User.IsInRole("Staff")
			? "Staff"
			: "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />

	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />

	<title>@ViewData["Title"] - iHouse</title>

	<!-- BOOTSTRAP -->
	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

	<!-- BOOTSTRAP ICONS -->
	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

	<!-- PROJECT CSS -->
	<link rel="stylesheet"
		  href="~/css/site.css"
		  asp-append-version="true" />

	<link rel="stylesheet"
		  href="~/css/admin.css"
		  asp-append-version="true" />

	@await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-body">

	<div class="admin-shell">

		<!-- =====================================
             SIDEBAR
        ===================================== -->
		<aside class="admin-sidebar">

			<!-- BRAND -->
			<a asp-controller="Admin"
			   asp-action="Index"
			   class="ihouse-logo">
				<span class="ihouse-logo-icon">
					<i class="bi bi-house-door"></i>
				</span>
				<span class="ihouse-logo-name">iHouse</span>
			</a>

			<!-- NAVIGATION -->
			<nav class="admin-nav">

				<!-- DASHBOARD -->
				<a asp-controller="Admin"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Admin" ? "active" : "")">

					<i class="bi bi-grid-1x2"></i>
					<span>Dashboard</span>
				</a>

				<!-- ROOMS -->
				<a asp-controller="Rooms"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Rooms" ? "active" : "")">

					<i class="bi bi-door-open"></i>
					<span>Rooms</span>
				</a>

				<!-- TENANTS -->
				<a asp-controller="Tenants"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Tenants" ? "active" : "")">

					<i class="bi bi-people"></i>
					<span>Tenants</span>
				</a>

				<!-- CONTRACTS -->
				<a asp-controller="Contracts"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Contracts" ? "active" : "")">

					<i class="bi bi-file-earmark-text"></i>
					<span>Contracts</span>
				</a>

				<!-- INVOICES -->
				<a asp-controller="Invoices"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Invoices" ? "active" : "")">

					<i class="bi bi-receipt"></i>
					<span>Invoices</span>
				</a>

				<!-- PAYMENTS -->
				<a asp-controller="Payment"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Payment" ? "active" : "")">

					<i class="bi bi-credit-card"></i>
					<span>Payments</span>
				</a>

				<!-- METER READINGS -->
				<a asp-controller="MeterReading"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "MeterReading" ? "active" : "")">

					<i class="bi bi-speedometer2"></i>
					<span>Meter Readings</span>
				</a>

				<!-- SERVICE PRICES -->
				<a asp-controller="ServicePrice"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "ServicePrice" ? "active" : "")">

					<i class="bi bi-tags"></i>
					<span>Service Prices</span>
				</a>

				<!-- MAINTENANCE -->
				<a asp-controller="Maintenance"
				   asp-action="Index"
				   class="admin-nav-link @(currentController == "Maintenance" ? "active" : "")">

					<i class="bi bi-tools"></i>
					<span>Maintenance</span>
				</a>

				@if (User.IsInRole("Admin"))
				{
					<!-- USER MANAGEMENT -->
					<a asp-controller="UserManagement"
					   asp-action="Index"
					   class="admin-nav-link @(currentController == "UserManagement" ? "active" : "")">

						<i class="bi bi-person-gear"></i>
						<span>User Management</span>
					</a>
				}

			</nav>

			<!-- SIDEBAR FOOTER -->
			<div class="admin-sidebar-footer">
				Property Management System
			</div>

		</aside>

		<!-- =====================================
             MAIN CONTENT
        ===================================== -->
		<div class="admin-main">

			<!-- TOPBAR -->
			<header class="admin-topbar">

				<!-- ACCOUNT DROPDOWN -->
				<div class="dropdown ih-admin-account">

					<button type="button"
							class="ih-admin-account-button"
							data-bs-toggle="dropdown"
							aria-expanded="false"
							aria-label="Open account menu">

						<span class="ih-admin-account-avatar">
							<i class="bi bi-person"></i>
						</span>

						<span class="ih-admin-account-text">
							<span class="ih-admin-account-name">
								@accountName
							</span>

							<span class="ih-admin-account-role">
								@accountRole
							</span>
						</span>

						<i class="bi bi-chevron-down text-secondary small"></i>
					</button>

					<ul class="dropdown-menu dropdown-menu-end ih-admin-dropdown">

						<li class="px-3 py-2">
							<div class="fw-semibold text-truncate">
								@accountName
							</div>

							<small class="text-muted">
								@accountRole
							</small>
						</li>

						<li>
							<hr class="dropdown-divider" />
						</li>

						<li>
							<a asp-controller="Admin"
							   asp-action="Index"
							   class="dropdown-item">

								<i class="bi bi-grid-1x2 me-2"></i>
								Dashboard
							</a>
						</li>

						<li>
							<hr class="dropdown-divider" />
						</li>

						<!-- LOGOUT -->
						<li>
							<form asp-controller="Account"
								  asp-action="Logout"
								  method="post">

								@Html.AntiForgeryToken()

								<button type="submit"
										class="dropdown-item text-danger">

									<i class="bi bi-box-arrow-right me-2"></i>
									Logout
								</button>
							</form>
						</li>

					</ul>
				</div>

			</header>

			<!-- PAGE CONTENT -->
			<main class="admin-content">
				@RenderBody()
			</main>

			<!-- FOOTER -->
			<footer class="admin-footer">
				&copy; @DateTime.Now.Year iHouse.
				All rights reserved.
			</footer>

		</div>
	</div>

	<!-- BOOTSTRAP JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
