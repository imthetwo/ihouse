
@{
    var isAdmin = User.IsInRole("Admin");
    var isStaff = User.IsInRole("Staff");

    var dashboardController = isAdmin ? "Admin" : "Staff";

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var accountName = User.Identity?.Name ?? "Account";

    var accountRole = isAdmin ? "Admin"
        : isStaff ? "Staff" : "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - iHouse</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Admin CSS -->
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-body">

    <div class="admin-shell">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <a href="@Url.Action("Index", dashboardController)"
               class="admin-brand">
                <span class="admin-brand-icon">⌂</span>
                <span>iHouse</span>
            </a>

            <nav class="admin-nav">

                <a href="@Url.Action("Index", dashboardController)"
                   class="admin-nav-link @(currentController == dashboardController ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("Index", "Rooms")"
                   class="admin-nav-link @(currentController == "Rooms" ? "active" : "")">
                    <i class="bi bi-door-open"></i>
                    <span>Rooms</span>
                </a>

                <a href="@Url.Action("Index", "Tenants")"
                   class="admin-nav-link @(currentController == "Tenants" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Tenants</span>
                </a>

                <a href="@Url.Action("Index", "Contracts")"
                   class="admin-nav-link @(currentController == "Contracts" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Contracts</span>
                </a>

                <a href="@Url.Action("Index", "Invoices")"
                   class="admin-nav-link @(currentController == "Invoices" ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Invoices</span>
                </a>

                <a href="@Url.Action("Index", "Payment")"
                   class="admin-nav-link @(currentController == "Payment" ? "active" : "")">
                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>
                </a>

                <a href="@Url.Action("Index", "MeterReading")"
                   class="admin-nav-link @(currentController == "MeterReading" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Meter Readings</span>
                </a>

                <a href="@Url.Action("Index", "ServicePrice")"
                   class="admin-nav-link @(currentController == "ServicePrice" ? "active" : "")">
                    <i class="bi bi-tags"></i>
                    <span>Service Prices</span>
                </a>

                <a href="@Url.Action("Index", "Maintenance")"
                   class="admin-nav-link @(currentController == "Maintenance" ? "active" : "")">
                    <i class="bi bi-tools"></i>
                    <span>Maintenance</span>
                </a>

            </nav>

            <div class="admin-sidebar-footer">
                Property Management System
            </div>

        </aside>

        <!-- MAIN AREA -->
        <div class="admin-main">

            <!-- HEADER -->
            <header class="admin-topbar d-flex justify-content-end align-items-center">

                <div class="dropdown ms-auto">

                    <button type="button"
                            class="admin-user border-0 bg-transparent dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Account menu">

                        <div class="admin-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="text-start">
                            <div class="admin-user-name">
                                @accountName
                            </div>

                            <div class="admin-user-role">
                                @accountRole
                            </div>
                        </div>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                        <li>
                            <a href="@Url.Action("Index", "Profile")"
                               class="dropdown-item">
                                <i class="bi bi-person-circle me-2"></i>
                                My Profile
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <form action="@Url.Action("Logout", "Account")"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </button>

                            </form>
                        </li>

                    </ul>
                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="admin-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="admin-footer">
                &copy; @DateTime.Now.Year iHouse. All rights reserved.
            </footer>

        </div>

    </div>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
