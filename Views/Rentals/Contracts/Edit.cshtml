
@model ihouse.ViewModels.Contract.ContractFormViewModel

@{
    ViewData["Title"] = "Edit Contract";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">Edit Contract</h4>

            <form asp-action="Edit"
                  asp-route-id="@ViewContext.RouteData.Values["id"]"
                  method="post">

                @Html.AntiForgeryToken()

                <partial name="_ContractForm" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Update Contract
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
