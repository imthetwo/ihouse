@model ihouse.ViewModels.Contract.ContractFormViewModel

@{
    ViewData["Title"] = "Create Contract";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-2">
                Create New Contract
            </h4>

            <p class="text-muted mb-4">
                Select a room, primary tenant and rental terms.
            </p>

            <form asp-controller="Contracts"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <partial name="_ContractForm"
                         model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="Contracts"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Contract
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>