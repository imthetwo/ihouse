@model IEnumerable<ihouse.Models.Tenant>

@{
    ViewData["Title"] = "Tenant Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Tenant Management</h4>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Tenant
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Identity Number</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@tenant.FullName</td>
                                <td>@tenant.IdentityNumber</td>
                                <td>@(tenant.Phone ?? "-")</td>
                                <td>@(tenant.Email ?? "-")</td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@tenant.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@tenant.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@tenant.Id"
                                              method="post"
                                              class="d-inline"
                                              data-confirm="Delete this tenant?">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No tenants found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
