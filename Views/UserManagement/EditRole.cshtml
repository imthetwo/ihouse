@model ihouse.ViewModels.UserManagement.EditUserRoleViewModel

@{
	ViewData["Title"] = "Edit User Role";
	Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

	<!-- PAGE HEADER -->
	<div class="d-flex align-items-center justify-content-between mb-4">
		<div>
			<h3 class="fw-bold mb-1">Edit User Role</h3>
			<p class="text-muted mb-0">
				Update user permissions and access level.
			</p>
		</div>

		<a asp-controller="UserManagement"
		   asp-action="Index"
		   class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left me-2"></i>
			Back to Users
		</a>
	</div>

	<div class="row justify-content-center">
		<div class="col-lg-8 col-xl-7">

			<div class="card border-0 shadow-sm rounded-4">
				<div class="card-body p-4 p-md-5">

					<!-- USER INFORMATION -->
					<div class="d-flex align-items-center gap-3 mb-4">

						<div class="bg-primary bg-opacity-10 text-primary
							rounded-circle d-flex align-items-center
							justify-content-center"
							 style="width:56px;height:56px;">

							<i class="bi bi-person-fill fs-3"></i>
						</div>

						<div>
							<h5 class="fw-bold mb-1">
								@Model.FullName
							</h5>

							<div class="text-muted small">
								@Model.Email
							</div>
						</div>
					</div>

					<hr class="my-4" />

					<!-- EDIT ROLE FORM -->
					<form asp-controller="UserManagement"
						  asp-action="EditRole"
						  method="post">

						@Html.AntiForgeryToken()

						<input asp-for="UserId" type="hidden" />

						<div asp-validation-summary="ModelOnly"
							 class="alert alert-danger"
							 role="alert"
							 id="validationSummary">
						</div>

						<!-- CURRENT ROLE -->
						<div class="mb-4">
							<label class="form-label fw-semibold">
								Current Role
							</label>

							<div>
								@{
									var currentRole = Model.CurrentRole;

									var roleBadgeClass = currentRole switch
									{
										"Admin" => "bg-danger-subtle text-danger",
										"Staff" => "bg-primary-subtle text-primary",
										"Tenant" => "bg-success-subtle text-success",
										_ => "bg-secondary-subtle text-secondary"
									};
								}

								<span class="badge @roleBadgeClass px-3 py-2 rounded-pill">
									<i class="bi bi-shield-check me-1"></i>
									@currentRole
								</span>
							</div>
						</div>

						<!-- NEW ROLE -->
						<div class="mb-4">

							<label asp-for="NewRole"
								   class="form-label fw-semibold">
								New Role
								<span class="text-danger">*</span>
							</label>

							<select asp-for="NewRole"
									class="form-select form-select-lg">

								<option value="">
									-- Select a role --
								</option>

								<option value="Admin">
									Admin
								</option>

								<option value="Staff">
									Staff
								</option>

								<option value="Tenant">
									Tenant
								</option>

							</select>

							<span asp-validation-for="NewRole"
								  class="text-danger small">
							</span>

							<div class="form-text">
								Select the permission level to assign to this user.
							</div>
						</div>

						<!-- ROLE DESCRIPTIONS -->
						<div class="bg-light rounded-3 p-3 mb-4">

							<h6 class="fw-semibold mb-3">
								<i class="bi bi-info-circle me-2 text-primary"></i>
								Role Permissions
							</h6>

							<div class="small text-muted">

								<p class="mb-2">
									<strong class="text-dark">Admin:</strong>
									Full access to system management,
									user roles and configuration.
								</p>

								<p class="mb-2">
									<strong class="text-dark">Staff:</strong>
									Manage tenants, rooms, contracts,
									invoices and daily operations.
								</p>

								<p class="mb-0">
									<strong class="text-dark">Tenant:</strong>
									Access personal rental information,
									invoices and payment features.
								</p>

							</div>
						</div>

						<!-- ADMIN PASSWORD -->
						<div class="mb-4">

							<label asp-for="AdminPassword"
								   class="form-label fw-semibold">
								Confirm Admin Password
								<span class="text-danger">*</span>
							</label>

							<div class="input-group">

								<span class="input-group-text bg-light">
									<i class="bi bi-lock"></i>
								</span>

								<input asp-for="AdminPassword"
									   type="password"
									   id="AdminPassword"
									   class="form-control form-control-lg"
									   placeholder="Enter your password"
									   autocomplete="current-password" />

								<button class="btn btn-outline-secondary"
										type="button"
										id="toggleAdminPassword"
										aria-label="Show password"
										aria-pressed="false">

									<i class="bi bi-eye" id="passwordIcon"></i>

								</button>

							</div>

							<span asp-validation-for="AdminPassword"
								  class="text-danger small">
							</span>

							<div class="form-text">
								For security, enter your administrator password
								to confirm this role change.
							</div>
						</div>

						<!-- SECURITY NOTICE -->
						<div class="alert alert-warning border-0 rounded-3 mb-4">

							<div class="d-flex gap-2">

								<i class="bi bi-exclamation-triangle-fill mt-1"></i>

								<div class="small">
									<strong>Security Notice</strong>

									<div class="mt-1">
										Changing a user's role will modify
										their access permissions.
										Make sure the selected role is correct.
									</div>
								</div>

							</div>
						</div>

						<!-- ACTION BUTTONS -->
						<div class="d-flex justify-content-end gap-2">

							<a asp-controller="UserManagement"
							   asp-action="Index"
							   class="btn btn-light border px-4">
								Cancel
							</a>

							<button type="submit"
									class="btn btn-primary px-4">

								<i class="bi bi-check-circle me-2"></i>
								Save Changes

							</button>

						</div>

					</form>

				</div>
			</div>

		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const passwordInput =
				document.getElementById("AdminPassword");

			const toggleButton =
				document.getElementById("toggleAdminPassword");

			const passwordIcon =
				document.getElementById("passwordIcon");

			if (passwordInput && toggleButton && passwordIcon) {
				toggleButton.addEventListener("click", function () {
					const showPassword =
						passwordInput.type === "password";

					passwordInput.type =
						showPassword ? "text" : "password";

					passwordIcon.className = showPassword
						? "bi bi-eye-slash"
						: "bi bi-eye";

					toggleButton.setAttribute(
						"aria-label",
						showPassword ? "Hide password" : "Show password"
					);

					toggleButton.setAttribute(
						"aria-pressed",
						String(showPassword)
					);
				});
			}

			const summary =
				document.getElementById("validationSummary");

			if (summary &&
				summary.querySelectorAll("li").length === 0) {
				summary.style.display = "none";
			}
		});
	</script>
}
