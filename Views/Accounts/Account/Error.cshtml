@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h2>Something went wrong</h2>

    <p class="text-muted">
        An unexpected error occurred.
        Please try again later.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-primary">
        Return to Login
    </a>
</div>